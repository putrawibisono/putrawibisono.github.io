---
import '../styles/global.css';
import { siteMetadata } from '../data/profile';

export interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  ogType?: 'website' | 'article' | 'profile';
}

const {
  title = siteMetadata.title,
  description = siteMetadata.subheadline,
  canonicalPath = Astro.url.pathname,
  ogType = 'website',
} = Astro.props;

const fullTitle = title === siteMetadata.title ? title : `${title}`;
const canonicalUrl = new URL(canonicalPath, siteMetadata.siteUrl).toString();
const ogImageUrl = new URL('/og-card.svg', siteMetadata.siteUrl).toString();

const tocEntries = [
  { href: '/', roman: 'I.', label: 'Overview' },
  { href: '/about/', roman: 'II.', label: 'Biography & Education' },
  { href: '/experience/', roman: 'III.', label: 'Work Experience' },
  { href: '/projects/', roman: 'IV.', label: 'Projects & Research' },
  { href: '/teaching/', roman: 'V.', label: 'Teaching (UCSD)' },
  { href: '/letters/', roman: 'VI.', label: 'Reference Letters' },
  { href: '/cv/', roman: 'VII.', label: 'Curriculum Vitae' },
  { href: '/contact/', roman: 'VIII.', label: 'Contact' },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) => {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
};

const activeEntry = tocEntries.find((item) => isActive(item.href)) || tocEntries[0];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: siteMetadata.name,
  jobTitle: 'Data Engineer & Materials Scientist; Acting President (as needed), Family-Owned Agricultural Business',
  description: siteMetadata.subheadline,
  url: siteMetadata.siteUrl,
  email: `mailto:${siteMetadata.email}`,
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'University of California, Berkeley' },
    { '@type': 'CollegeOrUniversity', name: 'University of California, San Diego' },
  ],
  sameAs: [siteMetadata.githubUrl, siteMetadata.repoGithubUrl],
};
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={siteMetadata.name} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteMetadata.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Typography: Newsreader, Instrument Sans, IBM Plex Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,400;0,500;1,400&family=Instrument+Sans:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,500;1,6..72,300;1,6..72,400&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Theme Initialization (Default to Uncoated Cotton Paper Light) -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('pw-monograph-theme');
          if (saved === 'dark' || saved === 'light') {
            document.documentElement.setAttribute('data-theme', saved);
          } else {
            document.documentElement.setAttribute('data-theme', 'light');
          }
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <!-- Mobile & Tablet Top Bar -->
    <header class="mobile-folio-bar">
      <div class="mobile-folio-top">
        <a href="/" class="mobile-author-name">{siteMetadata.name}</a>
        <div class="mobile-folio-controls">
          <button
            type="button"
            class="theme-switch-btn"
            data-theme-toggle
            aria-label="Switch reading surface tone"
          >
            <span class="mode-label-light">Dark Mode</span>
            <span class="mode-label-dark">Light Mode</span>
          </button>
          <button
            type="button"
            id="mobile-toc-btn"
            class="toc-toggle-btn"
            aria-expanded="false"
            aria-controls="mobile-toc-sheet"
          >
            Menu ({activeEntry.roman.replace('.', '')})
          </button>
        </div>
      </div>

      <nav id="mobile-toc-sheet" class="mobile-toc-sheet" hidden aria-label="Mobile Navigation">
        <ol class="toc-list">
          {
            tocEntries.map((item) => (
              <li class:list={[{ active: isActive(item.href) }]}>
                <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                  <span class="toc-title">
                    <span class="toc-roman">{item.roman}</span> {item.label}
                  </span>
                </a>
              </li>
            ))
          }
        </ol>
        <div class="mobile-toc-footer">
          <a href={`mailto:${siteMetadata.email}`} class="text-link">{siteMetadata.email}</a>
          <span>·</span>
          <a href={siteMetadata.githubUrl} target="_blank" rel="noopener noreferrer" class="text-link">
            github.com/{siteMetadata.githubUsername} ↗
          </a>
        </div>
      </nav>
    </header>

    <!-- Primary Editorial Frame -->
    <div class="monograph-wrapper">
      <div class="monograph-frame">
        <!-- Left Running Spine -->
        <aside class="monograph-spine" aria-label="Author Identity and Site Navigation">
          <div class="spine-sticky">
            <div class="spine-identity">
              <a href="/" class="spine-author">{siteMetadata.name}</a>
              <p class="spine-role-primary">Data Engineer &amp; Materials Scientist</p>
              <p class="spine-Subrole">Ex-Stripe &middot; Ex-Tesla &middot; Ex-Rivian</p>
              <p class="spine-Subrole" style="margin-top: 0.3rem;">
                Acting President (as needed),<br />Family-Owned Agricultural Business
              </p>
              <p class="spine-credentials" style="margin-top: 0.45rem;">
                M.Eng. UC Berkeley &middot; B.S. UCSD
              </p>
            </div>

            <nav class="spine-nav" aria-label="Primary Navigation">
              <p class="spine-rubric">Directory</p>
              <ol class="toc-list">
                {
                  tocEntries.map((item) => (
                    <li class:list={[{ active: isActive(item.href) }]}>
                      <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                        <span class="toc-title">
                          <span class="toc-roman">{item.roman}</span> {item.label}
                        </span>
                      </a>
                    </li>
                  ))
                }
              </ol>
            </nav>

            <div class="spine-correspondence">
              <p class="spine-rubric">Contact</p>
              <p class="spine-contact-line">
                <a href={`mailto:${siteMetadata.email}`} class="text-link">{siteMetadata.email}</a>
              </p>
              <p class="spine-contact-line" style="margin-top: 0.35rem;">
                <a href={siteMetadata.githubUrl} target="_blank" rel="noopener noreferrer" class="text-link">
                  github.com/{siteMetadata.githubUsername} ↗
                </a>
              </p>
            </div>

            <div class="spine-reading-mode">
              <button
                type="button"
                class="theme-switch-btn"
                data-theme-toggle
                aria-label="Toggle between Cotton Paper (Light) and Charcoal Vellum (Dark)"
              >
                <span class="mode-label-light">Switch to Dark Surface</span>
                <span class="mode-label-dark">Switch to Light Paper</span>
              </button>
            </div>
          </div>
        </aside>

        <!-- Main Content Area -->
        <main id="main-content" class="monograph-main">
          <slot />

          <footer class="monograph-colophon">
            <div class="colophon-row">
              <span>
                &copy; {new Date().getFullYear()} {siteMetadata.name} &middot; <a href={`mailto:${siteMetadata.email}`} class="text-link">{siteMetadata.email}</a>
              </span>
              <span class="mono-cite">
                <a href={siteMetadata.githubUrl} target="_blank" rel="noopener noreferrer" class="text-link">GitHub ({siteMetadata.githubUsername})</a>
                &middot;
                <a href="https://putrawibisono.com" class="text-link">putrawibisono.com</a>
              </span>
            </div>
          </footer>
        </main>
      </div>
    </div>

    <script is:inline>
      (function () {
        var toggleButtons = document.querySelectorAll('[data-theme-toggle]');
        toggleButtons.forEach(function (btn) {
          btn.addEventListener('click', function () {
            var current = document.documentElement.getAttribute('data-theme') || 'light';
            var next = current === 'light' ? 'dark' : 'light';
            document.documentElement.setAttribute('data-theme', next);
            try {
              localStorage.setItem('pw-monograph-theme', next);
            } catch (e) {}
          });
        });

        var tocBtn = document.getElementById('mobile-toc-btn');
        var tocSheet = document.getElementById('mobile-toc-sheet');
        if (tocBtn && tocSheet) {
          tocBtn.addEventListener('click', function () {
            var expanded = tocBtn.getAttribute('aria-expanded') === 'true';
            tocBtn.setAttribute('aria-expanded', String(!expanded));
            if (expanded) {
              tocSheet.setAttribute('hidden', '');
            } else {
              tocSheet.removeAttribute('hidden');
            }
          });
        }
      })();
    </script>
  </body>
</html>
