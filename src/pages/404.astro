---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Erratum 404: Folio Not Found — Putra Wibisono"
  description="The requested folio or archival URL does not exist in this edition."
>
  <article style="padding: 2rem 0 4rem;">
    <span class="rubric-mark">Erratum · HTTP 404</span>
    <h1 class="monograph-title">
      Folio <em>Not Found</em> in This Edition.
    </h1>

    <div class="essay-prose" style="margin-top: 1.35rem;">
      <p>
        The page or archival record you requested could not be located at this URL. If you followed a legacy bookmark from an earlier academic template, please consult the Table of Contents spine or select one of the primary folios below.
      </p>
    </div>

    <div style="margin-top: 2rem; display: flex; flex-wrap: wrap; gap: 0.85rem;">
      <a href="/" class="folio-action folio-action-rubric">
        ← Return to § I. Biographical Note
      </a>
      <a href="/projects/" class="folio-action">
        § IV. Engineering Monographs
      </a>
      <a href="/cv/" class="folio-action">
        § VII. Curriculum Vitae
      </a>
    </div>
  </article>
</BaseLayout>
