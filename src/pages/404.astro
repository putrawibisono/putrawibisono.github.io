---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Page Not Found" description="The requested page could not be found on putrawibisono.com.">
  <section class="section" style="padding: 6rem 0;">
    <div class="container" style="max-width: 680px; text-align: center;">
      <span class="eyebrow" style="justify-content: center;">
        <span class="eyebrow-dot" aria-hidden="true"></span>
        <span>HTTP 404 // ROUTE NOT FOUND</span>
      </span>
      <h1 class="display-title" style="margin-top: 0.75rem;">Coordinate Not Found</h1>
      <p class="lead-text" style="margin: 1rem auto 2rem;">
        The URL you requested does not exist or has been consolidated as part of the v2 architecture rebuild. Use the links below to navigate directly to verified sections.
      </p>
      <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem;">
        <a href="/" class="btn btn-primary">Return to Homepage</a>
        <a href="/projects/" class="btn btn-secondary">View Projects</a>
        <a href="/cv/" class="btn btn-secondary">Resume / CV</a>
        <a href="/letters/" class="btn btn-ghost">Recommendation Letters</a>
      </div>
    </div>
  </section>
</BaseLayout>
