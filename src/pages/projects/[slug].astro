---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SystemDiagram from '../../components/SystemDiagram.astro';
import { projectsList, siteMetadata, type ProjectItem } from '../../data/profile';

export function getStaticPaths() {
  return projectsList.map((project, idx) => {
    const prevProject = idx > 0 ? projectsList[idx - 1] : null;
    const nextProject = idx < projectsList.length - 1 ? projectsList[idx + 1] : null;
    return {
      params: { slug: project.slug },
      props: { project, prevProject, nextProject },
    };
  });
}

interface Props {
  project: ProjectItem;
  prevProject: ProjectItem | null;
  nextProject: ProjectItem | null;
}

const { project, prevProject, nextProject } = Astro.props;
---

<BaseLayout
  title={project.title}
  description={project.summary}
  canonicalPath={`/projects/${project.slug}/`}
  ogType="article"
>
  <section class="page-hero">
    <div class="container">
      <div style="margin-bottom: 1.25rem;">
        <a href="/projects/" class="btn btn-ghost">← Back to All Projects</a>
      </div>

      <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 0.65rem; margin-bottom: 0.75rem;">
        <span class="mono-meta">CASE STUDY // {project.index}</span>
        <span class="tag tag-accent">{project.category}</span>
        <span class="mono-meta">{project.organizationOrContext} &middot; {project.period}</span>
      </div>

      <h1 class="page-title">{project.title}</h1>
      <p class="lead-text" style="margin-top: 0.75rem;">{project.subtitle}</p>
    </div>
  </section>

  <section class="section">
    <div class="container detail-grid">
      <div class="detail-main">
        <div class="surface-card">
          <p class="mono-meta" style="margin-bottom: 0.65rem;">SYSTEM SCHEMATIC // ARCHITECTURE OVERVIEW</p>
          <SystemDiagram type={project.diagramType} />
        </div>

        {
          project.image && (
            <figure class="surface-card detail-photo-card">
              <img src={project.image} alt={project.title} loading="eager" />
              {project.imageCaption && <figcaption class="mono-meta">{project.imageCaption}</figcaption>}
            </figure>
          )
        }

        <div class="surface-card detail-prose-card">
          <h2 class="section-title">1. Problem &amp; Engineering Context</h2>
          <p class="detail-paragraph">{project.summary}</p>
          <p class="detail-paragraph">{project.challenge}</p>

          <h2 class="section-title" style="margin-top: 1.75rem;">2. System Architecture &amp; Technical Approach</h2>
          <ul class="detail-list">
            {project.architectureAndApproach.map((step) => <li>{step}</li>)}
          </ul>

          <h2 class="section-title" style="margin-top: 1.75rem;">3. Verified Outcomes &amp; Impact</h2>
          <ul class="detail-list">
            {project.outcomes.map((outcome) => <li>{outcome}</li>)}
          </ul>
        </div>
      </div>

      <aside class="detail-sidebar">
        <div class="surface-card" style="position: sticky; top: 6rem;">
          <h2 style="font-family: var(--font-serif); font-size: 1.45rem; font-weight: 400; margin-bottom: 1rem;">
            Technical Specifications
          </h2>

          <div style="margin-bottom: 1.25rem;">
            <p class="mono-meta" style="margin-bottom: 0.35rem;">ORGANIZATION / CONTEXT</p>
            <p style="font-weight: 600;">{project.organizationOrContext}</p>
          </div>

          <div style="margin-bottom: 1.25rem;">
            <p class="mono-meta" style="margin-bottom: 0.35rem;">TIMELINE</p>
            <p>{project.period}</p>
          </div>

          <div style="margin-bottom: 1.25rem;">
            <p class="mono-meta" style="margin-bottom: 0.5rem;">TECHNOLOGIES &amp; METHODS</p>
            <div style="display: flex; flex-wrap: wrap; gap: 0.4rem;">
              {project.technologies.map((t) => <span class="tag tag-accent">{t}</span>)}
            </div>
          </div>

          {
            project.codeAvailabilityNote && (
              <div class="code-note-box">
                <p class="mono-meta">REPOSITORY &amp; CODE ACCESS</p>
                <p style="font-size: 0.85rem; color: var(--text-secondary); margin-top: 0.25rem;">
                  {project.codeAvailabilityNote}
                </p>
              </div>
            )
          }

          <div style="margin-top: 1.5rem; display: flex; flex-direction: column; gap: 0.65rem;">
            <a
              href={`mailto:${siteMetadata.email}?subject=${encodeURIComponent(`Inquiry: ${project.title}`)}`}
              class="btn btn-primary"
              style="width: 100%;"
            >
              Discuss This Project →
            </a>
            <a href="/projects/" class="btn btn-secondary" style="width: 100%;">
              All Projects
            </a>
          </div>
        </div>
      </aside>
    </div>

    <!-- Prev / Next Navigation -->
    <div class="container project-pagination">
      {
        prevProject ? (
          <a href={`/projects/${prevProject.slug}/`} class="surface-card interactive pagination-card">
            <span class="mono-meta">← PREVIOUS CASE STUDY</span>
            <strong>{prevProject.title}</strong>
          </a>
        ) : (
          <div />
        )
      }
      {
        nextProject && (
          <a href={`/projects/${nextProject.slug}/`} class="surface-card interactive pagination-card next">
            <span class="mono-meta">NEXT CASE STUDY →</span>
            <strong>{nextProject.title}</strong>
          </a>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .detail-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: start;
  }

  @media (min-width: 960px) {
    .detail-grid {
      grid-template-columns: 1.5fr 0.8fr;
    }
  }

  .detail-main {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .detail-photo-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .detail-photo-card img {
    width: 100%;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-strong);
  }

  .detail-prose-card {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .detail-paragraph {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.72;
  }

  .detail-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .detail-list li {
    position: relative;
    padding-left: 1.35rem;
    font-size: 0.96rem;
    color: var(--text-secondary);
    line-height: 1.65;
  }

  .detail-list li::before {
    content: '▹';
    position: absolute;
    left: 0;
    color: var(--accent-primary);
    font-weight: 700;
  }

  .code-note-box {
    padding: 0.85rem;
    border-radius: var(--radius-sm);
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
  }

  .project-pagination {
    margin-top: 3rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 768px) {
    .project-pagination {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .pagination-card {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .pagination-card.next {
    text-align: right;
    align-items: flex-end;
  }
</style>
