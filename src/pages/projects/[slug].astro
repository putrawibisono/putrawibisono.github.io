---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SystemDiagram from '../../components/SystemDiagram.astro';
import { projectsList, siteMetadata, type ProjectItem } from '../../data/profile';

export function getStaticPaths() {
  return projectsList.map((project, index) => {
    const prevProject = index > 0 ? projectsList[index - 1] : null;
    const nextProject = index < projectsList.length - 1 ? projectsList[index + 1] : null;
    return {
      params: { slug: project.slug },
      props: { project, prevProject, nextProject },
    };
  });
}

interface Props {
  project: ProjectItem;
  prevProject: ProjectItem | null;
  nextProject: ProjectItem | null;
}

const { project, prevProject, nextProject } = Astro.props;
---

<BaseLayout
  title={`Monograph No. ${project.index}: ${project.title} — Putra Wibisono`}
  description={project.summary}
>
  <article>
    <div style="margin-bottom: 1.25rem;">
      <a href="/projects/" class="text-link mono-cite">
        ← Return to § IV. Engineering Monographs Index
      </a>
    </div>

    <div class="reading-with-margin">
      <div class="main-reading-col">
        <span class="rubric-mark">
          Monograph No. {project.index} · {project.category}
        </span>
        <h1 class="monograph-title">{project.title}</h1>
        <p class="monograph-subtitle">{project.subtitle}</p>

        <!-- Primary System Schematic Figure -->
        <div style="margin: 2rem 0;">
          <SystemDiagram type={project.diagramType} />
        </div>

        <!-- Section 1: Abstract & Problem Formulation -->
        <section class="monograph-subsection">
          <span class="rubric-mark">§ {project.index}.1 · Problem Formulation</span>
          <h2 class="section-heading">Context &amp; Engineering Challenge</h2>
          <div class="essay-prose" style="margin-top: 0.85rem;">
            <p class="dropcap">{project.summary}</p>
            <p>{project.challenge}</p>
          </div>
        </section>

        <!-- Section 2: System Architecture & Methodology -->
        <section class="monograph-subsection">
          <span class="rubric-mark">§ {project.index}.2 · Methodology &amp; System Design</span>
          <h2 class="section-heading">Architecture &amp; Analytical Approach</h2>
          <ol class="methodology-list">
            {project.architectureAndApproach.map((step, idx) => (
              <li>
                <span class="step-num">0{idx + 1}.</span>
                <span class="sans-note" style="color: var(--ink); font-size: 0.88rem;">{step}</span>
              </li>
            ))}
          </ol>
        </section>

        <!-- Optional Archival Photograph (e.g. Shimadzu UV-Vis-NIR Spectrophotometer) -->
        {project.image && (
          <section class="monograph-subsection">
            <span class="rubric-mark">§ {project.index}.3 · Laboratory Documentation</span>
            <h2 class="section-heading">Experimental Instrumentation Plate</h2>
            <figure class="archival-plate" style="margin-top: 1rem;">
              <img src={project.image} alt={project.title} loading="lazy" />
              {project.imageCaption && (
                <figcaption class="plate-caption">
                  <strong>Laboratory Record:</strong> {project.imageCaption}
                </figcaption>
              )}
            </figure>
          </section>
        )}

        <!-- Section 3: Empirical Outcomes -->
        <section class="monograph-subsection">
          <span class="rubric-mark">§ {project.index}.{project.image ? '4' : '3'} · Verification &amp; Results</span>
          <h2 class="section-heading">Documented Outcomes</h2>
          <ul class="outcomes-list">
            {project.outcomes.map((outcome) => (
              <li class="sans-note" style="color: var(--ink); font-size: 0.88rem;">
                {outcome}
              </li>
            ))}
          </ul>
        </section>
      </div>

      <!-- Right Marginalia Dossier Metadata -->
      <aside class="margin-column" aria-label="Monograph metadata">
        <div class="sidenote-block">
          <span class="sidenote-label">Monograph Classification</span>
          <p>
            <strong style="color: var(--ink);">No. {project.index}</strong> — {project.category}
          </p>
        </div>

        <div class="sidenote-block">
          <span class="sidenote-label">Institution / Context</span>
          <p>{project.organizationOrContext}</p>
        </div>

        <div class="sidenote-block">
          <span class="sidenote-label">Chronology</span>
          <p>{project.period}</p>
        </div>

        <div class="sidenote-block">
          <span class="sidenote-label">Instruments &amp; Methods</span>
          <p>{project.technologies.join(' · ')}</p>
        </div>

        {project.codeAvailabilityNote && (
          <div class="sidenote-block">
            <span class="sidenote-label">Archival Access Note</span>
            <p>{project.codeAvailabilityNote}</p>
          </div>
        )}

        <div class="sidenote-block">
          <span class="sidenote-label">Technical Correspondence</span>
          <p>
            For questions regarding methodology, code inspection, or research collaboration:
          </p>
          <p style="margin-top: 0.35rem;">
            <a
              href={`mailto:${siteMetadata.email}?subject=${encodeURIComponent(`Inquiry regarding Monograph No. ${project.index}: ${project.title}`)}`}
              class="text-link mono-cite"
            >
              Email {siteMetadata.email} →
            </a>
          </p>
        </div>
      </aside>
    </div>

    <!-- Sequential Folio Navigation -->
    <nav class="ledger-section folio-pagination" aria-label="Adjacent monographs">
      <div>
        {prevProject ? (
          <a href={`/projects/${prevProject.slug}/`} class="pagination-link">
            <span class="mono-cite">← Preceding Monograph (No. {prevProject.index})</span>
            <span class="pagination-title">{prevProject.title}</span>
          </a>
        ) : (
          <a href="/projects/" class="pagination-link">
            <span class="mono-cite">← Index</span>
            <span class="pagination-title">All Engineering Monographs</span>
          </a>
        )}
      </div>

      <div style="text-align: right;">
        {nextProject ? (
          <a href={`/projects/${nextProject.slug}/`} class="pagination-link">
            <span class="mono-cite">Following Monograph (No. {nextProject.index}) →</span>
            <span class="pagination-title">{nextProject.title}</span>
          </a>
        ) : (
          <a href="/projects/" class="pagination-link">
            <span class="mono-cite">Return to Index →</span>
            <span class="pagination-title">All Engineering Monographs</span>
          </a>
        )}
      </div>
    </nav>
  </article>
</BaseLayout>

<style>
  .monograph-subtitle {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.15rem;
    line-height: 1.48;
    color: var(--ink-secondary);
    margin-top: 0.65rem;
    max-width: 60ch;
  }

  .monograph-subsection {
    margin-top: 2.75rem;
    padding-top: 1.35rem;
    border-top: 1px solid var(--rule);
  }

  .methodology-list {
    list-style: none;
    margin-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.95rem;
  }

  .methodology-list li {
    display: grid;
    grid-template-columns: 2.1rem 1fr;
    align-items: baseline;
    padding-bottom: 0.95rem;
    border-bottom: 1px dotted var(--rule-dotted);
  }

  .step-num {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--rubric);
  }

  .outcomes-list {
    list-style: none;
    margin-top: 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .outcomes-list li {
    position: relative;
    padding-left: 1.15rem;
  }

  .outcomes-list li::before {
    content: '§';
    position: absolute;
    left: 0;
    top: 0;
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--rubric);
  }

  .folio-pagination {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  .pagination-link {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .pagination-title {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--rule-dotted);
    text-underline-offset: 4px;
  }

  .pagination-link:hover .pagination-title {
    color: var(--rubric);
    text-decoration-color: var(--rubric);
  }
</style>
