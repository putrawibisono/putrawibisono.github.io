---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projectsList, additionalEngineeringProjects } from '../../data/profile';

const categories = [
  'All',
  'Agri-Tech & IoT',
  'Data & Battery Systems',
  'Scientific Computing & Materials',
  'Software Engineering',
] as const;

const spectroscopyProject = projectsList.find((p) => p.slug === 'uv-vis-semiconductor-spectroscopy');
---

<BaseLayout
  title="Projects & Technical Case Studies"
  description="Engineering, data infrastructure, agricultural technology, battery telemetry, and scientific computing projects by Putra Wibisono."
  canonicalPath="/projects/"
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">
        <span class="eyebrow-dot" aria-hidden="true"></span>
        <span>03 // SYSTEMS, RESEARCH &amp; CASE STUDIES</span>
      </span>
      <h1 class="page-title" style="margin-top: 0.6rem;">
        Engineering &amp; Agri-Tech Projects
      </h1>
      <p class="lead-text" style="margin-top: 0.85rem;">
        Selected architectures, scientific models, and software systems built across agricultural technology, EV battery formation, semiconductor spectroscopy, and computer science.
      </p>

      <!-- Category Filter Bar -->
      <div class="filter-bar" role="toolbar" aria-label="Filter projects by category">
        {
          categories.map((cat, idx) => (
            <button
              type="button"
              class:list={['filter-btn', { active: idx === 0 }]}
              data-filter={cat}
              aria-pressed={idx === 0 ? 'true' : 'false'}
            >
              {cat}
            </button>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Main Project Cards Grid -->
  <section class="section">
    <div class="container">
      <div class="grid-2" id="projects-grid">
        {projectsList.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>

  <!-- Featured Lab Instrumentation Spotlight (Real Preserved Image) -->
  {
    spectroscopyProject && (
      <section class="section">
        <div class="container">
          <div class="surface-card lab-spotlight">
            <div class="lab-spotlight-copy">
              <span class="eyebrow">
                <span class="eyebrow-dot" aria-hidden="true"></span>
                <span>LABORATORY INSTRUMENTATION ARCHIVE</span>
              </span>
              <h2 class="section-title" style="margin-top: 0.4rem;">
                {spectroscopyProject.title}
              </h2>
              <p style="color: var(--text-secondary); font-size: 0.96rem; line-height: 1.65;">
                {spectroscopyProject.summary}
              </p>
              <p class="mono-meta" style="margin-top: 0.25rem;">
                INSTRUMENTATION: SHIMADZU SOLIDSPEC-3700 UV-VIS-NIR SPECTROPHOTOMETER
              </p>
              <div style="margin-top: 0.75rem;">
                <a href={`/projects/${spectroscopyProject.slug}/`} class="btn btn-primary">
                  Read Full Spectroscopy Case Study →
                </a>
              </div>
            </div>

            <figure class="lab-figure">
              <img
                src="/images/portfolio1.jpg"
                alt="Shimadzu SolidSpec-3700 UV-Vis-NIR Spectrophotometer workstation in the laboratory"
                loading="lazy"
                width="800"
                height="600"
              />
              <figcaption class="mono-meta">
                {spectroscopyProject.imageCaption}
              </figcaption>
            </figure>
          </div>
        </div>
      </section>
    )
  }

  <!-- Additional Engineering & Academic Project Index -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">
          <span class="eyebrow-dot" aria-hidden="true"></span>
          <span>ADDITIONAL COURSEWORK &amp; SIMULATION ARCHIVE</span>
        </span>
        <h2 class="section-title">Additional Engineering &amp; Software Models</h2>
        <p class="lead-text">
          Additional verified projects from chemical engineering, computational modeling, and computer science coursework (view-only source code available upon direct email request).
        </p>
      </div>

      <div class="surface-card archive-table-wrap">
        <table class="archive-table">
          <thead>
            <tr>
              <th>Project / Model</th>
              <th>Primary Stack / Discipline</th>
              <th>Context</th>
            </tr>
          </thead>
          <tbody>
            {
              additionalEngineeringProjects.map((item) => (
                <tr>
                  <td><strong>{item.name}</strong></td>
                  <td><span class="tag">{item.domain}</span></td>
                  <td class="mono-meta">{item.context}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    var buttons = document.querySelectorAll('.filter-btn');
    var cards = document.querySelectorAll('#projects-grid .project-card');
    if (!buttons.length || !cards.length) return;

    buttons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var filter = btn.getAttribute('data-filter');
        buttons.forEach(function (b) {
          b.classList.remove('active');
          b.setAttribute('aria-pressed', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-pressed', 'true');

        cards.forEach(function (card) {
          var cat = card.getAttribute('data-category');
          if (filter === 'All' || cat === filter) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  })();
</script>

<style>
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 2rem;
  }

  .filter-btn {
    padding: 0.5rem 0.95rem;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    background: var(--bg-card);
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .filter-btn:hover {
    color: var(--text-primary);
    border-color: var(--accent-border);
  }

  .filter-btn.active {
    background: var(--accent-primary);
    color: #07130e;
    border-color: var(--accent-primary);
    font-weight: 600;
  }

  [data-theme='light'] .filter-btn.active {
    color: #ffffff;
  }

  .lab-spotlight {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: center;
  }

  @media (min-width: 920px) {
    .lab-spotlight {
      grid-template-columns: 1.1fr 1fr;
    }
  }

  .lab-spotlight-copy {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .lab-figure {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .lab-figure img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-strong);
    object-fit: cover;
  }

  .archive-table-wrap {
    overflow-x: auto;
    padding: 0.5rem 1.25rem;
  }

  .archive-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
  }

  .archive-table th,
  .archive-table td {
    padding: 0.95rem 0.75rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .archive-table th {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }

  .archive-table tr:last-child td {
    border-bottom: none;
  }
</style>
