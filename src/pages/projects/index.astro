---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projectsList, additionalEngineeringProjects } from '../../data/profile';

const completedProjects = projectsList.filter(
  (p) => p.statusLabel !== 'Ongoing & Exploratory Initiative'
);
const ongoingInitiatives = projectsList.filter(
  (p) => p.statusLabel === 'Ongoing & Exploratory Initiative'
);

const categories = [
  'All Entries',
  'Data & Battery Systems',
  'Scientific Computing & Materials',
  'Software Engineering',
  'Agricultural Operations (In Progress)',
];
---

<BaseLayout
  title="Projects, Research & Field Initiatives — Putra Wibisono"
  description="Verified completed engineering and research projects (Tesla 4680 battery telemetry, UV-Vis semiconductor spectroscopy, COMSOL LPCVD reactor modeling, Java Gitlet, MATLAB acoustic scanning) and ongoing agricultural field initiatives."
>
  <article>
    <!-- Header + Authentic Laboratory Photograph Feature Spread (Distinct Composition for Projects Page) -->
    <header style="margin-bottom: 2.25rem;">
      <span class="rubric-mark">IV. Technical Studies &amp; Field Initiatives</span>
      <h1 class="monograph-title">
        Engineering <em>Projects</em> &amp; Laboratory Archive.
      </h1>
      <p class="sans-note" style="max-width: 68ch; margin-top: 0.75rem;">
        This archive separates <strong>completed industry and university engineering projects (01–05)</strong> from <strong>ongoing and exploratory agricultural initiatives (06)</strong> so that verified technical deliverables are clearly distinguished from work currently in progress.
      </p>
    </header>

    <!-- Featured Authentic Laboratory Plate Showcase -->
    <section class="plate-feature-banner" aria-labelledby="featured-plate-heading">
      <div class="plate-showcase">
        <figure class="archival-plate">
          <img
            src="/images/portfolio1.jpg"
            alt="Shimadzu SolidSpec-3700 UV-Vis-NIR Spectrophotometer and optical reference standards in the laboratory"
            loading="eager"
          />
          <figcaption class="plate-caption">
            <strong>Authentic Laboratory Photograph (Project 02):</strong> Experimental optical workstation featuring the Shimadzu SolidSpec-3700 UV-Vis-NIR Spectrophotometer and reference standards used to measure semiconductor thin-film band gaps.
          </figcaption>
        </figure>

        <div class="plate-commentary">
          <span class="status-tag">Completed Research / Lab Study</span>
          <h2 id="featured-plate-heading" class="section-heading" style="margin-top: 0.65rem;">
            Semiconductor Thin-Film Band Gap Analysis via UV-Vis Spectroscopy
          </h2>
          <p class="sans-note" style="margin-top: 0.65rem;">
            Combines ultraviolet, visible, and near-infrared optical measurements across two UV-Vis spectrometers to extract continuous absorption spectra and determine electronic band gaps in semiconductor thin films.
          </p>
          <div style="margin-top: 1.15rem;">
            <a href="/projects/uv-vis-semiconductor-spectroscopy/" class="folio-action folio-action-rubric">
              Open Spectroscopy Case Study →
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Filter Toolbar -->
    <section class="ledger-section" aria-label="Project directory">
      <div class="filter-bar" role="toolbar" aria-label="Filter projects by domain">
        <span class="mono-cite" style="margin-right: 0.4rem;">Filter by Domain:</span>
        {
          categories.map((cat, idx) => (
            <button
              type="button"
              class:list={['index-filter-btn', { active: idx === 0 }]}
              data-filter={cat}
              aria-pressed={idx === 0 ? 'true' : 'false'}
            >
              {cat}
            </button>
          ))
        }
      </div>

      <!-- Part I: Completed Engineering & Research Projects -->
      <div id="completed-projects-group" style="margin-top: 1.75rem;">
        <div class="ledger-header" style="margin-bottom: 0.5rem;">
          <h2 class="section-heading">Part I — Verified Completed Engineering &amp; Research Projects</h2>
          <span class="mono-cite">5 Completed Works (2020 – 2024)</span>
        </div>
        {
          completedProjects.map((project) => (
            <div class="project-item-wrapper" data-category={project.category}>
              <ProjectCard project={project} />
            </div>
          ))
        }
      </div>

      <!-- Part II: Ongoing & Exploratory Agricultural Initiatives -->
      <div id="ongoing-projects-group" style="margin-top: 3rem;">
        <div class="ledger-header" style="margin-bottom: 0.5rem;">
          <h2 class="section-heading">
            Part II — Current &amp; Exploratory Agricultural Initiatives <em>(In Progress)</em>
          </h2>
          <span class="mono-cite">Family-Owned Agricultural Business</span>
        </div>
        {
          ongoingInitiatives.map((project) => (
            <div class="project-item-wrapper" data-category={project.category}>
              <ProjectCard project={project} />
            </div>
          ))
        }
      </div>
    </section>

    <!-- Appendix: Additional Coursework & Simulation Models -->
    <section class="ledger-section" aria-labelledby="additional-studies-heading">
      <div class="ledger-header">
        <div>
          <h2 id="additional-studies-heading" class="section-heading">
            Additional Documented Coursework &amp; Simulation Projects
          </h2>
        </div>
        <span class="mono-cite">Verified in 2024 Resume</span>
      </div>

      <table class="ledger-table">
        <thead>
          <tr>
            <th style="width: 46%;">Project Title</th>
            <th style="width: 26%;">Discipline / Language</th>
            <th>Context</th>
          </tr>
        </thead>
        <tbody>
          {
            additionalEngineeringProjects.map((item) => (
              <tr>
                <td>
                  <strong style="color: var(--ink); font-weight: 600;">{item.name}</strong>
                </td>
                <td class="mono-cite" style="color: var(--rubric);">{item.domain}</td>
                <td class="sans-note">{item.context}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </section>
  </article>
</BaseLayout>

<script>
  function initMonographFilter() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('.index-filter-btn');
    const items = document.querySelectorAll<HTMLElement>('.project-item-wrapper');
    if (!buttons.length || !items.length) return;

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter') || 'All Entries';
        buttons.forEach((b) => {
          const active = b === btn;
          b.classList.toggle('active', active);
          b.setAttribute('aria-pressed', active ? 'true' : 'false');
        });

        items.forEach((item) => {
          const cat = item.getAttribute('data-category');
          const match = filter === 'All Entries' || cat === filter;
          item.style.display = match ? '' : 'none';
        });
      });
    });
  }

  initMonographFilter();
  document.addEventListener('astro:after-swap', initMonographFilter);
</script>

<style>
  .plate-feature-banner {
    background: var(--paper-tint);
    border: 1px solid var(--rule);
    border-top: 2px solid var(--rule-strong);
    padding: 1.5rem;
  }

  .plate-showcase {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.75rem;
    align-items: center;
  }

  @media (min-width: 860px) {
    .plate-showcase {
      grid-template-columns: 1.25fr 1fr;
      gap: 2.25rem;
    }
  }

  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.55rem 1.25rem;
    padding-bottom: 1.15rem;
    border-bottom: 1px solid var(--rule);
  }

  .index-filter-btn {
    background: transparent;
    border: none;
    padding: 0.2rem 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    color: var(--ink-muted);
    cursor: pointer;
    border-bottom: 1.5px solid transparent;
    transition: color 140ms ease, border-color 140ms ease;
  }

  .index-filter-btn:hover {
    color: var(--ink);
  }

  .index-filter-btn.active {
    color: var(--rubric);
    border-bottom-color: var(--rubric);
    font-weight: 500;
  }
</style>
