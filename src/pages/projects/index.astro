---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projectsList, additionalEngineeringProjects } from '../../data/profile';

const categories = [
  'All Entries',
  'Data & Battery Systems',
  'Scientific Computing & Materials',
  'Software Engineering',
];
---

<BaseLayout
  title="Projects & Research — Putra Wibisono"
  description="Industry and academic engineering projects by Putra Wibisono (Tesla FAST & RAPID battery telemetry, Rivian R1S/R2/R3 formation recipes, COMSOL LPCVD reactor modeling, Java Gitlet, and MATLAB acoustic/image signal analysis)."
>
  <article>
    <header style="margin-bottom: 2.25rem;">
      <span class="rubric-mark">IV. Projects &amp; Research</span>
      <h1 class="monograph-title">
        Engineering <em>Projects</em> &amp; Technical Systems.
      </h1>
      <p class="sans-note" style="max-width: 68ch; margin-top: 0.75rem;">
        Selected systems, simulations, and engineering projects from my industry work at Tesla and Rivian and my academic studies at UC Berkeley and UC San Diego.
      </p>
    </header>

    <!-- Filter Toolbar -->
    <section class="ledger-section" style="margin-top: 1.5rem;" aria-label="Project directory">
      <div class="filter-bar" role="toolbar" aria-label="Filter projects by domain">
        <span class="mono-cite" style="margin-right: 0.4rem;">Filter by Area:</span>
        {
          categories.map((cat, idx) => (
            <button
              type="button"
              class:list={['index-filter-btn', { active: idx === 0 }]}
              data-filter={cat}
              aria-pressed={idx === 0 ? 'true' : 'false'}
            >
              {cat}
            </button>
          ))
        }
      </div>

      <!-- Projects List -->
      <div id="completed-projects-group" style="margin-top: 1.75rem;">
        <div class="ledger-header" style="margin-bottom: 0.5rem;">
          <h2 class="section-heading">Featured Industry &amp; Academic Projects</h2>
          <span class="mono-cite">5 Projects (2020 – 2024)</span>
        </div>
        {
          projectsList.map((project) => (
            <div class="project-item-wrapper" data-category={project.category}>
              <ProjectCard project={project} />
            </div>
          ))
        }
      </div>
    </section>

    <!-- Appendix: Additional Coursework & Simulation Models -->
    <section class="ledger-section" aria-labelledby="additional-studies-heading">
      <div class="ledger-header">
        <div>
          <h2 id="additional-studies-heading" class="section-heading">
            Additional Coursework &amp; Simulation Projects
          </h2>
        </div>
        <span class="mono-cite">Chemical Engineering, MATLAB, C++ &amp; Java</span>
      </div>

      <table class="ledger-table">
        <thead>
          <tr>
            <th style="width: 46%;">Project Title</th>
            <th style="width: 24%;">Discipline / Language</th>
            <th>Context</th>
          </tr>
        </thead>
        <tbody>
          {
            additionalEngineeringProjects.map((item) => (
              <tr>
                <td>
                  <strong style="color: var(--ink); font-weight: 600;">{item.name}</strong>
                </td>
                <td class="mono-cite" style="color: var(--rubric);">{item.domain}</td>
                <td class="sans-note">{item.context}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </section>
  </article>
</BaseLayout>

<script>
  function initMonographFilter() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('.index-filter-btn');
    const items = document.querySelectorAll<HTMLElement>('.project-item-wrapper');
    if (!buttons.length || !items.length) return;

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter') || 'All Entries';
        buttons.forEach((b) => {
          const active = b === btn;
          b.classList.toggle('active', active);
          b.setAttribute('aria-pressed', active ? 'true' : 'false');
        });

        items.forEach((item) => {
          const cat = item.getAttribute('data-category');
          const match = filter === 'All Entries' || cat === filter;
          item.style.display = match ? '' : 'none';
        });
      });
    });
  }

  initMonographFilter();
  document.addEventListener('astro:after-swap', initMonographFilter);
</script>

<style>
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.55rem 1.25rem;
    padding-bottom: 1.15rem;
    border-bottom: 1px solid var(--rule);
  }

  .index-filter-btn {
    background: transparent;
    border: none;
    padding: 0.2rem 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    color: var(--ink-muted);
    cursor: pointer;
    border-bottom: 1.5px solid transparent;
    transition: color 140ms ease, border-color 140ms ease;
  }

  .index-filter-btn:hover {
    color: var(--ink);
  }

  .index-filter-btn.active {
    color: var(--rubric);
    border-bottom-color: var(--rubric);
    font-weight: 500;
  }
</style>
