---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projectsList, additionalEngineeringProjects } from '../../data/profile';

const categories = [
  'All Entries',
  'Data & Battery Systems',
  'Scientific Computing & Materials',
  'Software Engineering',
];
---

<BaseLayout
  title="Verified Engineering Projects — Putra Wibisono"
  description="Completed industry and university engineering projects verified by Putra Wibisono's December 2024 CV PDF (Tesla FAST & RAPID, Rivian R1S/R2/R3 formation recipes, COMSOL LPCVD reactor modeling, Java Gitlet, and MATLAB acoustic/image signal analysis)."
>
  <article>
    <header style="margin-bottom: 2.25rem;">
      <span class="rubric-mark">IV. Verified Technical Studies (files/cvsreal.pdf)</span>
      <h1 class="monograph-title">
        Completed <em>Engineering</em> Projects.
      </h1>
      <p class="sans-note" style="max-width: 68ch; margin-top: 0.75rem;">
        Every project featured on this page is independently corroborated by the December 2024 CV PDF (<code>files/cvsreal.pdf</code>). Template-modified placeholder files and exploratory agricultural concepts from the legacy website are excluded from this completed-project index and documented in the provenance note below.
      </p>
    </header>

    <!-- Filter Toolbar -->
    <section class="ledger-section" style="margin-top: 1.5rem;" aria-label="Project directory">
      <div class="filter-bar" role="toolbar" aria-label="Filter projects by domain">
        <span class="mono-cite" style="margin-right: 0.4rem;">Filter by Domain:</span>
        {
          categories.map((cat, idx) => (
            <button
              type="button"
              class:list={['index-filter-btn', { active: idx === 0 }]}
              data-filter={cat}
              aria-pressed={idx === 0 ? 'true' : 'false'}
            >
              {cat}
            </button>
          ))
        }
      </div>

      <!-- Verified Completed Engineering & Research Projects -->
      <div id="completed-projects-group" style="margin-top: 1.75rem;">
        <div class="ledger-header" style="margin-bottom: 0.5rem;">
          <h2 class="section-heading">Verified Completed Industry &amp; Academic Systems</h2>
          <span class="mono-cite">5 Works Verified in files/cvsreal.pdf (2020 – 2024)</span>
        </div>
        {
          projectsList.map((project) => (
            <div class="project-item-wrapper" data-category={project.category}>
              <ProjectCard project={project} />
            </div>
          ))
        }
      </div>
    </section>

    <!-- Appendix: Additional Coursework & Simulation Models -->
    <section class="ledger-section" aria-labelledby="additional-studies-heading">
      <div class="ledger-header">
        <div>
          <h2 id="additional-studies-heading" class="section-heading">
            Additional Documented Coursework &amp; Simulation Projects
          </h2>
        </div>
        <span class="mono-cite">Verified in files/cvsreal.pdf (Page 2)</span>
      </div>

      <table class="ledger-table">
        <thead>
          <tr>
            <th style="width: 46%;">Project Title</th>
            <th style="width: 24%;">Discipline / Language</th>
            <th>Provenance &amp; Context</th>
          </tr>
        </thead>
        <tbody>
          {
            additionalEngineeringProjects.map((item) => (
              <tr>
                <td>
                  <strong style="color: var(--ink); font-weight: 600;">{item.name}</strong>
                </td>
                <td class="mono-cite" style="color: var(--rubric);">{item.domain}</td>
                <td class="sans-note">{item.context}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </section>

    <!-- Content Provenance Exclusion Note -->
    <section class="ledger-section" aria-labelledby="provenance-exclusion-heading">
      <div class="provenance-box">
        <span class="sidenote-label" id="provenance-exclusion-heading">
          Content Provenance Note — Excluded Template &amp; Exploratory Items
        </span>
        <p class="sans-note" style="margin-top: 0.4rem;">
          <strong>1. Modified Template Portfolio File (<code>_portfolio/portfolio-1.md</code>):</strong> The legacy file <code>_portfolio/portfolio-1.md</code> (titled <em>"Absorption spectroscopy"</em>) was edited directly inside an upstream AcademicPages demonstration file while retaining verbatim template placeholder body text (<em>"This is an item in your portfolio..."</em>) and was subsequently commented out of site navigation in commit <code>9046f7b</code>. Because it has no corroboration in <code>files/cvsreal.pdf</code>, it is excluded from verified projects.<br />
          <strong>2. Exploratory Agricultural Concepts (<code>_pages/about.md</code>):</strong> High-level ideas mentioned in legacy <code>_pages/about.md</code> (field IoT tracking, historical satellite baseline analysis, organic fertilizer demonstration plots, and partner reporting) are not presented as active or completed engineering systems; see <a href="/about/" class="text-link">Biography &amp; Education</a> for their classification as unverified exploratory concepts.
        </p>
      </div>
    </section>
  </article>
</BaseLayout>

<script>
  function initMonographFilter() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('.index-filter-btn');
    const items = document.querySelectorAll<HTMLElement>('.project-item-wrapper');
    if (!buttons.length || !items.length) return;

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter') || 'All Entries';
        buttons.forEach((b) => {
          const active = b === btn;
          b.classList.toggle('active', active);
          b.setAttribute('aria-pressed', active ? 'true' : 'false');
        });

        items.forEach((item) => {
          const cat = item.getAttribute('data-category');
          const match = filter === 'All Entries' || cat === filter;
          item.style.display = match ? '' : 'none';
        });
      });
    });
  }

  initMonographFilter();
  document.addEventListener('astro:after-swap', initMonographFilter);
</script>

<style>
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.55rem 1.25rem;
    padding-bottom: 1.15rem;
    border-bottom: 1px solid var(--rule);
  }

  .index-filter-btn {
    background: transparent;
    border: none;
    padding: 0.2rem 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    color: var(--ink-muted);
    cursor: pointer;
    border-bottom: 1.5px solid transparent;
    transition: color 140ms ease, border-color 140ms ease;
  }

  .index-filter-btn:hover {
    color: var(--ink);
  }

  .index-filter-btn.active {
    color: var(--rubric);
    border-bottom-color: var(--rubric);
    font-weight: 500;
  }

  .provenance-box {
    background: var(--paper-tint);
    border: 1px solid var(--rule);
    border-left: 2px solid var(--rubric);
    padding: 1.15rem 1.35rem;
  }
</style>
