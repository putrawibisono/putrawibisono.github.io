---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projectsList, additionalEngineeringProjects } from '../../data/profile';

const categories = [
  'All Monographs',
  'Agri-Tech & IoT',
  'Data & Battery Systems',
  'Scientific Computing & Materials',
  'Software Engineering',
];
---

<BaseLayout
  title="IV. Engineering Monographs & Laboratory Archive — Putra Wibisono"
  description="Technical monographs, system schematics, and experimental studies spanning agricultural IoT pipelines, Tesla 4680 battery telemetry, UV-Vis semiconductor spectroscopy, and COMSOL reactor modeling."
>
  <article>
    <div class="reading-with-margin">
      <div class="main-reading-col">
        <span class="rubric-mark">§ IV. Technical Monographs · Fol. 04</span>
        <h1 class="monograph-title">
          Engineering <em>Monographs</em> &amp; Laboratory Archive.
        </h1>

        <div class="essay-prose" style="margin-top: 1.5rem;">
          <p class="dropcap">
            Rather than presenting software and physical engineering work as interchangeable marketing tiles, this archive documents six technical studies as self-contained monographs. Each entry pairs a statement of the underlying physical or computational problem with an architectural figure and a record of empirical outcomes.
          </p>
        </div>
      </div>

      <aside class="margin-column" aria-label="Archive notes">
        <div class="sidenote-block">
          <span class="sidenote-label">Indexing Convention</span>
          <p>
            Monographs 01–06 include dedicated system diagrams (<code>Fig. 1.1</code> through <code>Fig. 6.1</code>) and full methodological breakdowns on their individual folio pages.
          </p>
        </div>
        <div class="sidenote-block">
          <span class="sidenote-label">Source &amp; Reproducibility</span>
          <p>
            Where academic integrity policies or proprietary industrial agreements govern source code, view-only access or simulation reports are noted explicitly.
          </p>
        </div>
      </aside>
    </div>

    <!-- Typographic Index Filter Bar -->
    <section class="ledger-section" aria-label="Monograph index filter">
      <div class="filter-bar" role="toolbar" aria-label="Filter monographs by discipline">
        <span class="mono-cite" style="margin-right: 0.5rem;">Filter Index:</span>
        {categories.map((cat, idx) => (
          <button
            type="button"
            class:list={['index-filter-btn', { active: idx === 0 }]}
            data-filter={cat}
            aria-pressed={idx === 0 ? 'true' : 'false'}
          >
            {cat}
          </button>
        ))}
      </div>

      <div id="projects-monograph-list">
        {projectsList.map((project) => (
          <div class="project-item-wrapper" data-category={project.category}>
            <ProjectCard project={project} />
          </div>
        ))}
      </div>
    </section>

    <!-- Archival Plate Feature: UV-Vis-NIR Spectrophotometer -->
    <section class="ledger-section" aria-labelledby="archival-plate-heading">
      <div class="ledger-header">
        <div>
          <span class="rubric-mark" style="margin-bottom: 0.2rem;">Archival Plate I · Experimental Optical Physics</span>
          <h2 id="archival-plate-heading" class="section-heading">
            Shimadzu SolidSpec-3700 UV-Vis-NIR Spectrophotometer Workstation
          </h2>
        </div>
        <a href="/projects/uv-vis-semiconductor-spectroscopy/" class="text-link mono-cite">
          Open Monograph No. 03 →
        </a>
      </div>

      <div class="plate-showcase">
        <figure class="archival-plate">
          <img
            src="/images/portfolio1.jpg"
            alt="Shimadzu SolidSpec-3700 UV-Vis-NIR Spectrophotometer and optical reference standards in the laboratory"
            loading="lazy"
          />
          <figcaption class="plate-caption">
            <strong>Plate I (Original Laboratory Photograph):</strong> Experimental optical bench featuring the Shimadzu SolidSpec-3700 UV-Vis-NIR Spectrophotometer, spectral reference standards, and acquisition terminal used to measure transmission and reflectance across semiconductor thin-film samples.
          </figcaption>
        </figure>

        <div class="plate-commentary">
          <span class="sidenote-label">Instrument &amp; Calibration Notes</span>
          <p class="sans-note" style="margin-top: 0.4rem;">
            Wide-band optical characterization requires stitching spectral measurements across ultraviolet, visible, and near-infrared regimes while correcting for detector switching artifacts and substrate interference.
          </p>
          <p class="sans-note" style="margin-top: 0.75rem;">
            By reconciling dual-spectrometer transmittance and reflectance curves in Python and MATLAB, the pipeline extracts continuous absorption coefficients ($\alpha$) and constructs Tauc plots ($(\alpha h\nu)^n$ vs. $h\nu$) to resolve direct and indirect electronic band gaps.
          </p>
          <div style="margin-top: 1.25rem;">
            <a href="/projects/uv-vis-semiconductor-spectroscopy/" class="folio-action">
              Read Full Spectroscopy Study →
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Additional Engineering & Simulation Studies Table -->
    <section class="ledger-section" aria-labelledby="additional-studies-heading">
      <div class="ledger-header">
        <div>
          <span class="rubric-mark" style="margin-bottom: 0.2rem;">Appendix A · Additional Works</span>
          <h2 id="additional-studies-heading" class="section-heading">
            Supplementary Coursework, Simulations &amp; Software Engines
          </h2>
        </div>
        <span class="mono-cite">Verified CV Archive</span>
      </div>

      <table class="ledger-table">
        <thead>
          <tr>
            <th style="width: 14%;">Ref.</th>
            <th style="width: 44%;">Study or System Title</th>
            <th style="width: 24%;">Primary Methods</th>
            <th>Context</th>
          </tr>
        </thead>
        <tbody>
          {additionalEngineeringProjects.map((item, idx) => (
            <tr>
              <td class="mono-cite">APP. 0{idx + 1}</td>
              <td>
                <strong style="color: var(--ink); font-weight: 600;">{item.name}</strong>
              </td>
              <td class="mono-cite" style="color: var(--rubric);">{item.domain}</td>
              <td class="sans-note">{item.context}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  </article>
</BaseLayout>

<script>
  function initMonographFilter() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('.index-filter-btn');
    const items = document.querySelectorAll<HTMLElement>('.project-item-wrapper');
    if (!buttons.length || !items.length) return;

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter') || 'All Monographs';
        buttons.forEach((b) => {
          const active = b === btn;
          b.classList.toggle('active', active);
          b.setAttribute('aria-pressed', active ? 'true' : 'false');
        });

        items.forEach((item) => {
          const cat = item.getAttribute('data-category');
          const match = filter === 'All Monographs' || cat === filter;
          item.style.display = match ? '' : 'none';
        });
      });
    });
  }

  initMonographFilter();
  document.addEventListener('astro:after-swap', initMonographFilter);
</script>

<style>
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.55rem 1.25rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--rule);
  }

  .index-filter-btn {
    background: transparent;
    border: none;
    padding: 0.2rem 0;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.03em;
    color: var(--ink-muted);
    cursor: pointer;
    border-bottom: 1.5px solid transparent;
    transition: color 140ms ease, border-color 140ms ease;
  }

  .index-filter-btn:hover {
    color: var(--ink);
  }

  .index-filter-btn.active {
    color: var(--rubric);
    border-bottom-color: var(--rubric);
    font-weight: 500;
  }

  .plate-showcase {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: start;
  }

  @media (min-width: 860px) {
    .plate-showcase {
      grid-template-columns: 1.35fr 1fr;
      gap: 2.5rem;
    }
  }

  .plate-commentary {
    border-top: 1px solid var(--rule);
    padding-top: 1rem;
  }
</style>
