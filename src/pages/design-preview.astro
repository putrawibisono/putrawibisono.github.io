    light: {
      paper: '#F4F6F0',
      paperTint: '#E7ECE2',
      paperDeep: '#DAE2D3',
      ink: '#111B17',
      inkSecondary: '#2A3D34',
      inkMuted: '#475E52',
      rubric: '#1F573A',
      rubricHover: '#153F29',
      accentPastel: '#A9CFB2',
      rule: '#C8D3C2',
      ruleDotted: '#93A58E',
      ruleStrong: '#111B17',
    },
    dark: {
      paper: '#111B17',
      paperTint: '#22362B',
      paperDeep: '#2C4537',
      ink: '#DCE8DD',
      inkSecondary: '#BBD0BE',
      inkMuted: '#8FA994',
      rubric: '#A9CFB2',
      rubricHover: '#C4E2CB',
      accentPastel: '#A9CFB2',
      rule: '#2F493B',
      ruleDotted: '#436653',
      ruleStrong: '#DCE8DD',
    },
    contrasts: [
      { pair: 'Primary Text (--ink on --paper)', light: '16.17 : 1 (AAA)', dark: '13.94 : 1 (AAA)' },
      { pair: 'Primary Text on Elevated Surface (--ink on --paper-tint)', light: '14.66 : 1 (AAA)', dark: '10.20 : 1 (AAA)' },
      { pair: 'Secondary Text (--ink-secondary on --paper)', light: '10.62 : 1 (AAA)', dark: '10.80 : 1 (AAA)' },
      { pair: 'Muted Metadata (--ink-muted on --paper)', light: '6.45 : 1 (AA)', dark: '6.93 : 1 (AA)' },
      { pair: 'Muted Metadata on Surface (--ink-muted on --paper-tint)', light: '5.85 : 1 (AA)', dark: '5.07 : 1 (AA)' },
      { pair: 'Primary Accent / Rubric (--rubric on --paper)', light: '7.77 : 1 (AAA)', dark: '10.27 : 1 (AAA)' },
      { pair: 'Primary Accent on Surface (--rubric on --paper-tint)', light: '7.05 : 1 (AAA)', dark: '7.52 : 1 (AAA)' },
