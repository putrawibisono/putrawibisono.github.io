---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
import { projectsList, experienceList } from '../data/profile';

const sampleProject = projectsList[0];
const sampleExperiences = experienceList.slice(0, 2);

