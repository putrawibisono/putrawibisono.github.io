      { pair: 'Secondary Text (--ink-secondary on --paper)', light: '10.69 : 1 (AAA)', dark: '11.36 : 1 (AAA)' },
      { pair: 'Muted Metadata (--ink-muted on --paper)', light: '6.43 : 1 (AA)', dark: '7.16 : 1 (AAA)' },
      { pair: 'Muted Metadata on Surface (--ink-muted on --paper-tint)', light: '5.92 : 1 (AA)', dark: '5.90 : 1 (AA)' },
      { pair: 'Primary Accent / Rubric (--rubric on --paper)', light: '6.99 : 1 (AA)', dark: '10.22 : 1 (AAA)' },
      { pair: 'Primary Accent on Surface (--rubric on --paper-tint)', light: '6.43 : 1 (AA)', dark: '8.42 : 1 (AAA)' },
      { pair: 'Interactive Hover (--rubric-hover on --paper)', light: '9.96 : 1 (AAA)', dark: '12.64 : 1 (AAA)' },
