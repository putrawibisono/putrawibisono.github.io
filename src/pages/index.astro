---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import {
  siteMetadata,
  identityPillars,
  biographyNarrative,
  experienceList,
  projectsList,
  skillGroups,
} from '../data/profile';

const completedFeaturedProjects = projectsList.filter(
  (p) => p.featured && p.statusLabel !== 'Ongoing & Exploratory Initiative'
);
---

<BaseLayout
  title={siteMetadata.title}
  description={siteMetadata.subheadline}
>
  <!-- 3-Second Identity Summary Banner -->
  <section class="identity-banner" aria-label="Professional Identity Summary">
    <div class="identity-banner-top">
      <div class="identity-name-line">
        <span class="identity-primary-role">{siteMetadata.roleHeadline}</span>
        <span class="mono-cite">·</span>
        <span class="sans-note" style="color: var(--rubric); font-weight: 500;">
          {siteMetadata.currentRoleTag}
        </span>
      </div>
      <div class="mono-cite">
        <a href={`mailto:${siteMetadata.email}`} class="text-link">{siteMetadata.email}</a>
      </div>
    </div>

    <div class="identity-pillars-grid">
      {identityPillars.map((pillar) => (
        <div class="identity-pillar">
          <span class="pillar-label">{pillar.label}</span>
          <strong class="pillar-title">{pillar.primary}</strong>
          <p class="pillar-detail">{pillar.detail}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Section 1: Biographical Essay + Marginalia & Laboratory Plate -->
  <div class="reading-with-margin">
    <div class="main-reading-col">
      <span class="rubric-mark">I. Biographical Overview</span>
      <h1 class="monograph-title">
        Data engineering, <em>materials science</em>, and agricultural operations.
      </h1>

      <div class="essay-prose" style="margin-top: 1.5rem;">
        <p class="dropcap essay-lead">
          {biographyNarrative.lead}
        </p>
        {biographyNarrative.paragraphs.map((para) => <p>{para}</p>)}
      </div>

      <div style="margin-top: 1.75rem; display: flex; flex-wrap: wrap; gap: 0.75rem;">
        <a href="/experience/" class="folio-action folio-action-rubric">
          Inspect Work Experience →
        </a>
        <a href="/projects/" class="folio-action">
          Completed Engineering Projects →
        </a>
        <a href="/cv/" class="folio-action">
          Curriculum Vitae
        </a>
      </div>
    </div>

    <!-- Right Margin Column: Laboratory Photograph Plate & Quick Notes -->
    <aside class="margin-column" aria-label="Laboratory documentation and quick references">
      <figure class="archival-plate">
        <img
          src="/images/portfolio1.jpg"
          alt="Shimadzu SolidSpec-3700 UV-Vis-NIR Spectrophotometer bench used for semiconductor thin-film band-gap characterization"
          loading="eager"
        />
        <figcaption class="plate-caption">
          <span class="sidenote-label" style="display: block; margin-bottom: 0.25rem;">
            Laboratory Archive · Optical Physics
          </span>
          Shimadzu SolidSpec-3700 UV-Vis-NIR spectrophotometer workstation used to measure semiconductor thin-film optical band gaps (<a href="/projects/uv-vis-semiconductor-spectroscopy/" class="text-link">Project 02</a>).
        </figcaption>
      </figure>

      <div class="sidenote-block">
        <span class="sidenote-label">Teaching &amp; Reference Letters</span>
        <p>
          Contributed to undergraduate computer science instruction at UC San Diego (<a href="/teaching/" class="text-link">CSE 8A &amp; CSE 20</a>). Former colleagues and students may review the protocol for <a href="/letters/" class="text-link">recommendation letters</a>.
        </p>
      </div>

      <div class="sidenote-block">
        <span class="sidenote-label">Direct Contact</span>
        <p>
          Reach out directly via <a href={`mailto:${siteMetadata.email}`} class="text-link">{siteMetadata.email}</a> or view <a href="/contact/" class="text-link">contact details →</a>
        </p>
      </div>
    </aside>
  </div>

  <!-- Tinted Callout: Current Agricultural Responsibilities & Ongoing Initiatives -->
  <section class="initiatives-callout" aria-labelledby="agri-initiatives-heading">
    <span class="rubric-mark" style="margin-bottom: 0.2rem;">
      Family-Owned Agricultural Business · Acting President (as needed)
    </span>
    <h2 id="agri-initiatives-heading" class="section-heading">
      {biographyNarrative.currentInitiativesTitle}
    </h2>
    <p class="sans-note" style="margin-top: 0.35rem;">
      {biographyNarrative.currentInitiativesSubtitle}
    </p>

    <div class="initiatives-grid">
      {
        biographyNarrative.currentInitiatives.map((item) => (
          <div class="initiative-item">
            <div style="margin-bottom: 0.35rem;">
              <span
                class:list={[
                  'status-tag',
                  { 'status-tag-rubric': item.status === 'Active Operations' },
                ]}
              >
                {item.status}
              </span>
            </div>
            <strong style="font-family: var(--font-sans); font-size: 0.9rem; color: var(--ink); display: block; margin-bottom: 0.25rem;">
              {item.title}
            </strong>
            <p class="sans-note" style="font-size: 0.82rem;">{item.description}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Section 2: Chronological Experience Summary -->
  <section class="ledger-section" aria-labelledby="home-career-heading">
    <div class="ledger-header">
      <div>
        <span class="rubric-mark" style="margin-bottom: 0.2rem;">II. Career Record</span>
        <h2 id="home-career-heading" class="section-heading">
          Professional &amp; Research Appointments
        </h2>
      </div>
      <a href="/experience/" class="text-link mono-cite">Full Experience Dossier →</a>
    </div>

    <table class="ledger-table">
      <thead>
        <tr>
          <th style="width: 19%;">Period</th>
          <th style="width: 27%;">Organization</th>
          <th style="width: 26%;">Role &amp; Classification</th>
          <th>Primary Scope</th>
        </tr>
      </thead>
      <tbody>
        {
          experienceList.map((exp) => (
            <tr>
              <td class="mono-cite" style="color: var(--rubric); font-weight: 500;">{exp.period}</td>
              <td>
                <strong style="color: var(--ink); font-weight: 600;">
                  <a href={`/experience/#${exp.id}`} class="text-link">{exp.organization}</a>
                </strong>
                <div class="mono-cite">{exp.location}</div>
              </td>
              <td>
                <div style="color: var(--ink); font-weight: 500;">{exp.role}</div>
                <div class="mono-cite">{exp.statusType}</div>
              </td>
              <td style="color: var(--ink-secondary);">{exp.summary}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </section>

  <!-- Section 3: Selected Completed Engineering & Research Projects -->
  <section class="ledger-section" aria-labelledby="home-projects-heading">
    <div class="ledger-header">
      <div>
        <span class="rubric-mark" style="margin-bottom: 0.2rem;">III. Completed Technical Works</span>
        <h2 id="home-projects-heading" class="section-heading">
          Selected Engineering &amp; Research Studies
        </h2>
      </div>
      <a href="/projects/" class="text-link mono-cite">All 5 Completed Projects &amp; Field Initiatives →</a>
    </div>

    <div>
      {completedFeaturedProjects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <!-- Section 4: Technical Stack & Laboratory Instrumentation -->
  <section class="ledger-section" aria-labelledby="home-skills-heading">
    <div class="ledger-header">
      <div>
        <span class="rubric-mark" style="margin-bottom: 0.2rem;">IV. Technical Capabilities</span>
        <h2 id="home-skills-heading" class="section-heading">
          Software Stack &amp; Laboratory Instrumentation
        </h2>
      </div>
      <a href="/cv/" class="text-link mono-cite">Full Curriculum Vitae →</a>
    </div>

    <table class="ledger-table">
      <thead>
        <tr>
          <th style="width: 34%;">Domain</th>
          <th>Documented Languages, Platforms &amp; Instruments</th>
        </tr>
      </thead>
      <tbody>
        {
          skillGroups.map((group) => (
            <tr>
              <td>
                <strong style="color: var(--ink); font-weight: 600;">{group.category}</strong>
                <div class="mono-cite">{group.sourceNote}</div>
              </td>
              <td style="color: var(--ink-secondary);">
                {group.skills.join(' · ')}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </section>
</BaseLayout>
