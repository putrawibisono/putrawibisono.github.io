---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import {
  siteMetadata,
  biographyNarrative,
  experienceList,
  projectsList,
  skillGroups,
} from '../data/profile';

const selectedMonographs = projectsList.slice(0, 3);
---

<BaseLayout title={siteMetadata.title} description={siteMetadata.subheadline} canonicalPath="/">
  <!-- Top Monograph Essay + Right Marginalia Column -->
  <div class="reading-with-margin">
    <div class="essay-prose">
      <span class="rubric-mark">§ I — PERSONAL BIOGRAPHY &amp; FIELD NOTES</span>
      <h1 class="monograph-title" style="margin-bottom: 1.75rem;">
        From high-volume data pipelines in California to <em>soil and satellite</em> systems in agriculture.
      </h1>

      <p class="dropcap">
        I am Putra Wibisono—a former Senior Data Engineer turned agricultural technology founder. I began my career building data infrastructure and physical process models across financial systems, electric vehicle battery manufacturing, and computational drug discovery at <strong>Stripe</strong>, <strong>Tesla</strong>, <strong>ATOM Science</strong>, and <strong>Rivian</strong>. Across each of those environments, my work centered on a single problem: making noisy, high-volume measurements clean, reliable, and actionable so engineers and decision-makers could move with confidence.
      </p>

      <p>
        Today, I am channeling that technical foundation into agriculture. Working at the intersection of distributed data systems and soil science, I help farmers, agronomists, and institutional partners adopt evidence-based fertilizer strategies, monitor crop yields, and restore long-term soil health.
      </p>

      <!-- Four Current Agricultural Initiatives as Numbered Paragraphs (Not Cards) -->
      <div class="field-notes-block">
        <div class="ledger-header">
          <h2 class="section-heading">Current Field &amp; Engineering Work in Agriculture</h2>
          <span class="mono-cite">Agros Industry</span>
        </div>

        <ol class="numbered-initiatives">
          {
            biographyNarrative.currentInitiatives.map((item, idx) => (
              <li>
                <span class="init-num">0{idx + 1}.</span>
                <div>
                  <strong>{item.title}.</strong> {item.description}
                </div>
              </li>
            ))
          }
        </ol>
      </div>

      <!-- § II. Chronological Record of Work (Hairline Ledger Table) -->
      <section class="ledger-section">
        <div class="ledger-header">
          <h2 class="section-heading">§ II. Chronological Record of Work</h2>
          <a href="/experience/" class="text-link sans-note">Full Career Dossier (06 Roles) →</a>
        </div>

        <table class="ledger-table">
          <thead>
            <tr>
              <th>Period</th>
              <th>Organization</th>
              <th>Role &amp; Focus</th>
            </tr>
          </thead>
          <tbody>
            {
              experienceList.map((exp) => (
                <tr>
                  <td class="mono-cite" style="white-space: nowrap; width: 135px;">{exp.period}</td>
                  <td style="font-weight: 600; color: var(--ink); width: 185px;">
                    <a href={`/experience/#${exp.id}`} class="text-link">{exp.organization}</a>
                  </td>
                  <td style="color: var(--ink-secondary);">
                    <strong style="color: var(--ink); font-weight: 500;">{exp.role}</strong> — {exp.domainTag}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </section>
    </div>

    <!-- Right Marginalia & Archival Plate Column -->
    <aside class="margin-column" aria-label="Marginalia and Archival Notes">
      <div class="sidenote-block">
        <span class="sidenote-label">Note 1 · Academic Training</span>
        <p>
          <strong>UC Berkeley</strong> — M.Eng. in Materials Science &amp; Engineering, Concentration in Data Science (June 2023, Major GPA 3.92).
        </p>
        <p style="margin-top: 0.45rem;">
          <strong>UC San Diego</strong> — B.S. in Chemical Engineering, Minor in Computer Science (June 2021).
        </p>
      </div>

      <figure class="archival-plate">
        <img
          src="/images/portfolio1.jpg"
          alt="Shimadzu SolidSpec-3700 UV-Vis-NIR Spectrophotometer in the laboratory"
          width="400"
          height="300"
        />
        <figcaption class="plate-caption">
          <span class="sidenote-label" style="display:block; margin-bottom:0.2rem;">Plate I · Laboratory Archive</span>
          Shimadzu SolidSpec-3700 UV-Vis-NIR spectrophotometer bench used to determine semiconductor thin-film optical band gaps (<a href="/projects/uv-vis-semiconductor-spectroscopy/" class="text-link">Monograph No. 03</a>).
        </figcaption>
      </figure>

      <div class="sidenote-block">
        <span class="sidenote-label">Note 2 · UCSD Instruction &amp; Letters</span>
        <p>
          Taught undergraduate computer science at UC San Diego (<a href="/teaching/" class="text-link">CSE 8A: Python</a> &amp; <a href="/teaching/" class="text-link">CSE 20: Discrete Math</a>).
        </p>
        <p style="margin-top: 0.45rem;">
          Former colleagues at Stripe/Tesla and UCSD students may request recommendation letters via <a href="/letters/" class="text-link">§ VI. Letters</a> (please allow 3–4 weeks).
        </p>
      </div>

      <div class="sidenote-block">
        <span class="sidenote-label">Note 3 · Curriculum Vitae</span>
        <p>
          A typeset, print-ready <a href="/cv/" class="text-link">Curriculum Vitae (§ VII)</a> and the archived 2024 engineering resume PDF are available for direct download.
        </p>
      </div>
    </aside>
  </div>

  <!-- § III. Selected Engineering Monographs -->
  <section class="ledger-section" style="margin-top: 4rem;">
    <div class="ledger-header">
      <div>
        <span class="rubric-mark">§ III — SELECTED TECHNICAL MONOGRAPHS</span>
        <h2 class="section-heading">Systems, Instruments &amp; Case Studies</h2>
      </div>
      <a href="/projects/" class="text-link sans-note">Complete Archive (06 Monographs) →</a>
    </div>

    <div>
      {selectedMonographs.map((project) => <ProjectCard project={project} showDiagram={true} />)}
    </div>
  </section>

  <!-- § IV. Technical Concordance (Tabular, Zero Pill Clouds) -->
  <section class="ledger-section">
    <div class="ledger-header">
      <div>
        <span class="rubric-mark">§ IV — TECHNICAL CONCORDANCE</span>
        <h2 class="section-heading">Languages, Data Platforms &amp; Scientific Instruments</h2>
      </div>
      <a href="/about/" class="text-link sans-note">Read Essay &amp; Methodology →</a>
    </div>

    <table class="ledger-table">
      <thead>
        <tr>
          <th style="width: 110px;">Ref.</th>
          <th style="width: 240px;">Discipline</th>
          <th>Primary Tools, Frameworks &amp; Experimental Methods</th>
        </tr>
      </thead>
      <tbody>
        {
          skillGroups.map((group) => (
            <tr>
              <td class="mono-cite">{group.code}</td>
              <td style="font-weight: 600; color: var(--ink);">{group.category}</td>
              <td style="color: var(--ink-secondary);">
                {group.skills.map((s) => s.name).join(' · ')}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </section>
</BaseLayout>

<style>
  .field-notes-block {
    margin-top: 2.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }

  .numbered-initiatives {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    font-family: var(--font-sans);
    font-size: 0.84rem;
    line-height: 1.6;
    color: var(--ink-secondary);
  }

  .numbered-initiatives li {
    display: grid;
    grid-template-columns: 32px 1fr;
    align-items: baseline;
  }

  .init-num {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--rubric);
  }

  .numbered-initiatives strong {
    color: var(--ink);
    font-weight: 600;
  }
</style>
