---
import BaseLayout from '../layouts/BaseLayout.astro';
import { recommendationLetterPolicy } from '../data/profile';
---

<BaseLayout
  title="Recommendation Letters & Reference Protocol — Putra Wibisono"
  description="Protocol and required materials for requesting academic or professional recommendation letters from Putra Wibisono."
>
  <article>
    <div class="reading-with-margin">
      <div class="main-reading-col">
        <span class="rubric-mark">VI. Academic &amp; Professional References</span>
        <h1 class="monograph-title">
          Recommendation <em>Letters</em> &amp; Protocol.
        </h1>

        <div class="essay-prose" style="margin-top: 1.5rem;">
          <p class="essay-lead">
            {recommendationLetterPolicy.lead}
          </p>
          <p>
            {recommendationLetterPolicy.philosophy}
          </p>
        </div>
      </div>

      <aside class="margin-column" aria-label="Notice and lead time">
        <div class="sidenote-block">
          <span class="sidenote-label">Lead-Time Requirement</span>
          <p>
            <strong style="color: var(--rubric);">Minimum 3–4 Weeks Notice:</strong> {recommendationLetterPolicy.timelineNotice}
          </p>
        </div>

        <div class="sidenote-block">
          <span class="sidenote-label">Direct Email</span>
          <p>
            Send requests to <a href={`mailto:${recommendationLetterPolicy.contactEmail}?subject=${encodeURIComponent(recommendationLetterPolicy.subjectLine)}`} class="text-link mono-cite">{recommendationLetterPolicy.contactEmail}</a> with the subject line <code>"{recommendationLetterPolicy.subjectLine}"</code>.
          </p>
        </div>
      </aside>
    </div>

    <!-- Part I: Eligibility & Evaluation Scope -->
    <section class="ledger-section" aria-labelledby="eligibility-heading">
      <div class="ledger-header">
        <h2 id="eligibility-heading" class="section-heading">Who I Can Write For &amp; Areas of Evaluation</h2>
      </div>

      <table class="ledger-table">
        <thead>
          <tr>
            <th style="width: 28%;">Candidate Group</th>
            <th>Relationship &amp; Context</th>
          </tr>
        </thead>
        <tbody>
          {recommendationLetterPolicy.eligibleGroups.map((item) => (
            <tr>
              <td>
                <strong style="color: var(--ink); font-weight: 600;">{item.group}</strong>
              </td>
              <td class="sans-note">{item.detail}</td>
            </tr>
          ))}
          <tr>
            <td>
              <strong style="color: var(--rubric); font-weight: 600;">Areas of Expertise</strong>
            </td>
            <td class="sans-note">
              {recommendationLetterPolicy.credibleAreas.join(' · ')}
            </td>
          </tr>
        </tbody>
      </table>
    </section>

    <!-- Part II: Required Materials & Interactive Draft Generator -->
    <section class="ledger-section" aria-labelledby="packet-heading">
      <div class="ledger-header">
        <h2 id="packet-heading" class="section-heading">What I Need From You (Checklist 01–05)</h2>
      </div>

      <div class="reading-with-margin" style="margin-top: 1rem;">
        <div>
          <ol class="packet-checklist">
            {recommendationLetterPolicy.requiredMaterials.map((item) => (
              <li>
                <span class="mono-cite" style="color: var(--rubric);">{item.step}.</span>
                <div>
                  <strong style="font-family: var(--font-sans); font-size: 0.88rem; color: var(--ink); display: block;">
                    {item.title}
                  </strong>
                  <span class="sans-note">{item.detail}</span>
                </div>
              </li>
            ))}
          </ol>
        </div>

        <!-- Archival Worksheet: Pre-populate Mailto Request -->
        <aside class="worksheet-box" aria-labelledby="worksheet-title">
          <span class="sidenote-label" id="worksheet-title">Request Email Formatter</span>
          <p class="sans-note" style="font-size: 0.78rem; margin-top: 0.3rem;">
            Complete the fields below to format a structured email draft to <code>{recommendationLetterPolicy.contactEmail}</code>:
          </p>

          <div class="worksheet-fields">
            <label class="worksheet-label" for="req-name">
              <span>Your Full Name</span>
              <input id="req-name" type="text" placeholder="e.g., Jane Doe" class="worksheet-input" />
            </label>

            <label class="worksheet-label" for="req-context">
              <span>How We Worked Together</span>
              <select id="req-context" class="worksheet-input">
                <option value="Tesla Battery / Data Engineering">Tesla Battery / Data Engineering</option>
                <option value="Rivian Battery Cell Formation">Rivian Battery Cell Formation</option>
                <option value="ATOM Science / Molecular ML">ATOM Science / Molecular ML</option>
                <option value="UC Berkeley / UC San Diego Research">UC Berkeley / UC San Diego Research</option>
                <option value="Business Operations & Strategy (Family-Owned Enterprise)">Business Operations &amp; Strategy (Family-Owned Enterprise)</option>
              </select>
            </label>

            <label class="worksheet-label" for="req-deadline">
              <span>Earliest Submission Deadline</span>
              <input id="req-deadline" type="date" class="worksheet-input" />
            </label>

            <button
              type="button"
              id="compose-letter-btn"
              class="folio-action folio-action-rubric"
              style="width: 100%; justify-content: center; margin-top: 0.4rem;"
            >
              Compose Request Email →
            </button>
          </div>
        </aside>
      </div>
    </section>
  </article>
</BaseLayout>

<script>
  function initLetterWorksheet() {
    const btn = document.getElementById('compose-letter-btn');
    if (!btn) return;

    btn.addEventListener('click', () => {
      const nameInput = document.getElementById('req-name') as HTMLInputElement | null;
      const contextInput = document.getElementById('req-context') as HTMLSelectElement | null;
      const deadlineInput = document.getElementById('req-deadline') as HTMLInputElement | null;

      const name = nameInput?.value.trim() || '[Your Name]';
      const context = contextInput?.value || '[Our Connection / Course / Team]';
      const deadline = deadlineInput?.value || '[Earliest Deadline Date]';

      const subject = `Recommendation Letter Request — ${name}`;
      const body = [
        'Dear Putra,',
        '',
        'I hope you are doing well. I am writing to request a letter of recommendation in support of my upcoming application.',
        '',
        '1. CURRENT RESUME / CV:',
        '[Attached to this email / Linked here]',
        '',
        '2. OPPORTUNITY DETAILS & EARLIEST DEADLINE:',
        '- Target Program / Role: [Insert Graduate Program or Position]',
        `- Earliest Deadline: ${deadline}`,
        '- Submission Method: [Portal Link / Direct Email]',
        '',
        '3. OUR CONNECTION & TIMEFRAME:',
        `- Context: ${context}`,
        '- Dates Worked Together: [Insert Term or Dates]',
        '',
        '4. SPECIFIC PROJECTS & ACCOMPLISHMENTS:',
        '- [Highlight 1-2 projects, trials, or coursework milestones]',
        '',
        '5. OPTIONAL TALKING POINTS:',
        '- [Key technical or leadership strengths to emphasize]',
        '',
        'Thank you very much for your time and consideration.',
        '',
        'Best regards,',
        name,
      ].join('\r\n');

      window.location.href = `mailto:putrawibisonos@gmail.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    });
  }

  initLetterWorksheet();
  document.addEventListener('astro:after-swap', initLetterWorksheet);
</script>

<style>
  .packet-checklist {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .packet-checklist li {
    display: grid;
    grid-template-columns: 2rem 1fr;
    align-items: baseline;
    padding-bottom: 1rem;
    border-bottom: 1px dotted var(--rule-dotted);
  }

  .worksheet-box {
    background: var(--paper-tint);
    border: 1px solid var(--rule);
    padding: 1.25rem;
    align-self: start;
  }

  .worksheet-fields {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 0.85rem;
  }

  .worksheet-label {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--ink-secondary);
  }

  .worksheet-input {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    padding: 0.45rem 0.6rem;
    background: var(--paper);
    color: var(--ink);
    border: 1px solid var(--rule-strong);
    border-radius: 0;
  }
</style>
