---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  siteMetadata,
  biographyNarrative,
  educationList,
  skillGroups,
} from '../data/profile';
---

<BaseLayout
  title="About Me & Education — Putra Wibisono"
  description="Background, education at UC Berkeley and UC San Diego, and current work in Business Operations & Strategy at a family-owned enterprise."
>
  <article>
    <header style="border-bottom: 1.5px solid var(--rule-strong); padding-bottom: 1.5rem; margin-bottom: 2.25rem;">
      <span class="rubric-mark">II. Biography &amp; Education</span>
      <h1 class="monograph-title">
        From chemical &amp; materials engineering to <em>battery telemetry</em> and business operations.
      </h1>
    </header>

    <!-- Two-Column Education Section -->
    <section aria-labelledby="academic-diptych-heading" style="margin-bottom: 3rem;">
      <div class="ledger-header" style="margin-bottom: 1rem;">
        <h2 id="academic-diptych-heading" class="section-heading">Education</h2>
        <span class="mono-cite">University of California</span>
      </div>

      <div class="academic-diptych">
        {
          educationList.map((edu) => (
            <div class="degree-card">
              <div class="degree-meta">
                <span class="mono-cite" style="color: var(--rubric); font-weight: 500;">
                  {edu.graduationDate} · {edu.location}
                </span>
                {edu.honorsOrGpa && <span class="status-tag">{edu.honorsOrGpa}</span>}
              </div>
              <h3 class="degree-inst">{edu.institution}</h3>
              <p class="degree-name">{edu.degree}</p>
              <p class="degree-conc">{edu.concentrationOrMinor}</p>
              <ul class="degree-focus">
                {edu.focusAreas.map((area) => <li>{area}</li>)}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <!-- My Background + Marginalia -->
    <div class="reading-with-margin" style="border-top: 1px solid var(--rule); padding-top: 2.25rem;">
      <div class="main-reading-col">
        <h2 class="section-heading" style="margin-bottom: 1.15rem;">My Background</h2>
        <div class="essay-prose">
          <p class="essay-lead">{biographyNarrative.lead}</p>
          {biographyNarrative.paragraphs.map((para) => <p>{para}</p>)}
        </div>

        <blockquote class="editorial-pullquote">
          “{biographyNarrative.philosophyQuote}”
        </blockquote>

        <div class="role-clarification-note">
          <span class="sidenote-label">Current Role</span>
          <p class="sans-note" style="margin-top: 0.35rem;">
            In my current work—<strong>Business Operations &amp; Strategy — Family-Owned Enterprise</strong>—I help manage day-to-day operations and strategic planning at our family's agricultural business, while evaluating field trials and practical ways to use data for soil assessment and partner reporting.
          </p>
        </div>
      </div>

      <aside class="margin-column" aria-label="Skills and laboratory notes">
        <div class="sidenote-block">
          <span class="sidenote-label">Technical Skills</span>
          <p>
            <strong>Proficient:</strong> Python (NumPy, Pandas, Matplotlib.pyplot), SQL, C++, Java, MATLAB, COMSOL, Aspen, TensorFlow &amp; Keras, AWS.<br />
            <strong>Additional:</strong> C, HTML, CSS, JavaScript.
          </p>
        </div>

        <div class="sidenote-block">
          <span class="sidenote-label">Laboratory Experience</span>
          <p>
            Hands-on experimental work in coin-cell assembly, automated battery cyclers, cathode active material synthesis, XRD, FTIR, NMR, vacuum ovens, ROTAP shakers, and glove-box operations at UC San Diego Nanoengineering.
          </p>
        </div>

        <div class="sidenote-block">
          <span class="sidenote-label">Contact</span>
          <p>
            <a href={`mailto:${siteMetadata.email}`} class="text-link">{siteMetadata.email}</a>
          </p>
        </div>
      </aside>
    </div>

    <!-- Technical Skills & Instrumentation Table -->
    <section class="ledger-section" aria-labelledby="stack-concordance-heading">
      <div class="ledger-header">
        <div>
          <h2 id="stack-concordance-heading" class="section-heading">
            Technical Skills &amp; Laboratory Instrumentation
          </h2>
        </div>
        <a href="/cv/" class="text-link mono-cite">View Curriculum Vitae →</a>
      </div>

      <table class="ledger-table">
        <thead>
          <tr>
            <th style="width: 34%;">Area</th>
            <th style="width: 32%;">Focus</th>
            <th>Languages, Tools &amp; Techniques</th>
          </tr>
        </thead>
        <tbody>
          {
            skillGroups.map((group) => (
              <tr>
                <td>
                  <strong style="color: var(--ink); font-weight: 600;">{group.category}</strong>
                </td>
                <td class="sans-note">{group.description}</td>
                <td class="sans-note" style="color: var(--ink);">
                  {group.skills.join(' · ')}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </section>
  </article>
</BaseLayout>

<style>
  .academic-diptych {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
  }

  @media (min-width: 780px) {
    .academic-diptych {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2rem;
    }
  }

  .degree-card {
    background: var(--paper-tint);
    border: 1px solid var(--rule);
    border-top: 2px solid var(--rule-strong);
    padding: 1.35rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .degree-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.25rem;
  }

  .degree-inst {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 1.3rem;
    color: var(--ink);
  }

  .degree-name {
    font-family: var(--font-sans);
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--ink);
  }

  .degree-conc {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.98rem;
    color: var(--rubric);
  }

  .degree-focus {
    list-style: none;
    margin-top: 0.65rem;
    padding-top: 0.65rem;
    border-top: 1px dotted var(--rule-dotted);
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: var(--ink-secondary);
  }

  .degree-focus li {
    position: relative;
    padding-left: 0.95rem;
  }

  .degree-focus li::before {
    content: '·';
    position: absolute;
    left: 0;
    color: var(--rubric);
    font-weight: 700;
  }

  .editorial-pullquote {
    margin: 2rem 0;
    padding: 0.85rem 0 0.85rem 1.35rem;
    border-left: 2px solid var(--rubric);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.2rem;
    line-height: 1.5;
    color: var(--ink);
  }

  .role-clarification-note {
    background: var(--paper-tint);
    border: 1px solid var(--rule);
    padding: 1.15rem 1.35rem;
    margin-top: 1.75rem;
  }
</style>
