---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  siteMetadata,
  biographyNarrative,
  educationList,
  skillGroups,
} from '../data/profile';
---

<BaseLayout
  title="Essay & Education"
  description="Biographical essay, academic training at UC Berkeley and UC San Diego, and agricultural technology work of Putra Wibisono."
  canonicalPath="/about/"
  ogType="profile"
>
  <div class="reading-with-margin">
    <article class="essay-prose">
      <span class="rubric-mark">§ II — BIOGRAPHICAL ESSAY &amp; ACADEMIC TRAINING</span>
      <h1 class="monograph-title" style="margin-bottom: 1.75rem;">
        On physical measurements, reliable pipelines, and returning to <em>agriculture</em>.
      </h1>

      <p class="dropcap">
        {biographyNarrative.paragraphs[0]}
      </p>
      <p>
        {biographyNarrative.paragraphs[1]}
      </p>
      <p>
        {biographyNarrative.paragraphs[2]}
      </p>

      <blockquote class="essay-epigraph">
        “{biographyNarrative.philosophyQuote}”
      </blockquote>

      <!-- Education as Narrative Academic Record (Not Dashboard Cards) -->
      <section class="ledger-section">
        <div class="ledger-header">
          <h2 class="section-heading">Academic Training &amp; Degrees</h2>
          <span class="mono-cite">California, 2017 — 2023</span>
        </div>

        <div class="academic-records">
          {
            educationList.map((edu, idx) => (
              <div class="academic-item">
                <div class="academic-item-head">
                  <div>
                    <span class="mono-cite" style="color: var(--rubric);">DEGREE 0{idx + 1} // {edu.graduationDate}</span>
                    <h3 class="academic-inst">{edu.institution}</h3>
                  </div>
                  {edu.honorsOrGpa && <span class="mono-cite">{edu.honorsOrGpa}</span>}
                </div>

                <p class="academic-degree">
                  {edu.degree} — <em>{edu.concentrationOrMinor}</em>
                </p>

                <ul class="academic-focus">
                  {edu.focusAreas.map((area) => (
                    <li>{area}</li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Technical Concordance -->
      <section class="ledger-section">
        <div class="ledger-header">
          <h2 class="section-heading">Technical Stack &amp; Scientific Computing Concordance</h2>
        </div>

        <table class="ledger-table">
          <thead>
            <tr>
              <th style="width: 220px;">Domain</th>
              <th>Scope &amp; Production Technologies</th>
            </tr>
          </thead>
          <tbody>
            {
              skillGroups.map((group) => (
                <tr>
                  <td style="font-weight: 600; color: var(--ink);">
                    {group.category}
                    <span class="mono-cite" style="display:block; font-weight:400; margin-top:0.15rem;">{group.code}</span>
                  </td>
                  <td style="color: var(--ink-secondary);">
                    <p style="margin-bottom: 0.35rem;">{group.description}</p>
                    <p class="mono-cite" style="color: var(--ink);">
                      {group.skills.map((s) => s.name).join(' · ')}
                    </p>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </section>
    </article>

    <!-- Right Marginalia -->
    <aside class="margin-column" aria-label="Biographical Sidenotes">
      <div class="sidenote-block">
        <span class="sidenote-label">Dossier Summary</span>
        <p><strong>Name:</strong> {siteMetadata.name}</p>
        <p><strong>Current Focus:</strong> Cofounder, Agricultural Technologies (Agros Industry)</p>
        <p><strong>Prior Tenures:</strong> Stripe, Tesla, ATOM Science, Rivian</p>
        <p><strong>Location:</strong> Berkeley, CA &amp; Indonesia</p>
      </div>

      <div class="sidenote-block">
        <span class="sidenote-label">Note a · Chemical &amp; Materials Foundation</span>
        <p>
          Training in chemical engineering (UCSD) and materials science (UC Berkeley) grounded my approach to data science in conservation laws, transport phenomena, and experimental design ($2^k$ factorial screening) before scaling to cloud data platforms.
        </p>
      </div>

      <div class="sidenote-block">
        <span class="sidenote-label">Note b · Agricultural Field Trials</span>
        <p>
          Rather than treating agricultural software as purely a dashboard problem, our work pairs remote satellite baselines with physical demonstration plot trials to measure actual soil pH, moisture, and organic fertilizer yield response.
        </p>
      </div>

      <div class="sidenote-block">
        <span class="sidenote-label">Direct Links</span>
        <p><a href="/cv/" class="text-link">Curriculum Vitae (§ VII) →</a></p>
        <p style="margin-top: 0.3rem;"><a href="/letters/" class="text-link">Recommendation Letters (§ VI) →</a></p>
        <p style="margin-top: 0.3rem;"><a href={`mailto:${siteMetadata.email}`} class="text-link">{siteMetadata.email}</a></p>
      </div>
    </aside>
  </div>
</BaseLayout>

<style>
  .essay-epigraph {
    margin: 2rem 0;
    padding: 0.5rem 0 0.5rem 1.35rem;
    border-left: 2px solid var(--rubric);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.28rem;
    line-height: 1.42;
    color: var(--ink);
  }

  .academic-records {
    display: flex;
    flex-direction: column;
  }

  .academic-item {
    padding: 1.5rem 0;
    border-top: 1px solid var(--rule);
  }

  .academic-item-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
  }

  .academic-inst {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 1.4rem;
    color: var(--ink);
    margin-top: 0.15rem;
  }

  .academic-degree {
    font-family: var(--font-sans);
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--ink-secondary);
    margin: 0.3rem 0 0.75rem;
  }

  .academic-focus {
    list-style: none;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: var(--ink-secondary);
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .academic-focus li {
    position: relative;
    padding-left: 1rem;
  }

  .academic-focus li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--rubric);
  }
</style>
