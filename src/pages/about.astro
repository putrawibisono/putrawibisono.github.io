---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  siteMetadata,
  biographyNarrative,
  educationList,
  skillGroups,
} from '../data/profile';
---

<BaseLayout
  title="About Putra Wibisono"
  description="Biography, engineering background, academic training at UC Berkeley and UC San Diego, and current agricultural technology mission."
  canonicalPath="/about/"
  ogType="profile"
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">
        <span class="eyebrow-dot" aria-hidden="true"></span>
        <span>01 // BIOGRAPHY &amp; ENGINEERING PHILOSOPHY</span>
      </span>
      <h1 class="page-title" style="margin-top: 0.6rem;">
        From Distributed Data Pipelines to Precision Agriculture
      </h1>
      <p class="lead-text" style="margin-top: 0.85rem;">
        {biographyNarrative.lead}
      </p>
    </div>
  </section>

  <!-- Main Biography Narrative -->
  <section class="section">
    <div class="container about-grid">
      <div class="about-prose">
        <h2 class="section-title">The Thread Connecting Silicon Valley &amp; Soil Health</h2>
        {biographyNarrative.paragraphs.map((p) => <p class="prose-paragraph">{p}</p>)}

        <blockquote class="editorial-pullquote">
          <p>“{biographyNarrative.philosophyQuote}”</p>
        </blockquote>

        <h3 class="subsection-heading">{biographyNarrative.currentInitiativesTitle}</h3>
        <div class="grid-2" style="margin-top: 1.25rem;">
          {
            biographyNarrative.currentInitiatives.map((item) => (
              <div class="surface-card">
                <span class="mono-meta">{item.code}</span>
                <h4 style="font-size: 1.05rem; margin: 0.35rem 0 0.45rem; color: var(--text-primary);">
                  {item.title}
                </h4>
                <p style="font-size: 0.9rem; color: var(--text-secondary);">{item.description}</p>
              </div>
            ))
          }
        </div>
      </div>

      <aside class="about-sidebar">
        <div class="surface-card profile-summary-card">
          <div class="monogram-banner">
            <span class="large-monogram">PW</span>
            <div>
              <h2 style="font-size: 1.25rem; font-weight: 600;">{siteMetadata.name}</h2>
              <p class="mono-meta">Agri-Tech Entrepreneur &amp; Data Engineer</p>
            </div>
          </div>

          <dl class="sidebar-facts">
            <div>
              <dt class="mono-meta">CURRENT ROLE</dt>
              <dd>Cofounder, Agricultural Technologies (Agros Industry)</dd>
            </div>
            <div>
              <dt class="mono-meta">PREVIOUS ROLES</dt>
              <dd>Senior Data Engineer at Stripe &middot; Sr. Data Engineer (P3) / Data Scientist at Tesla &middot; ATOM Science &middot; Rivian</dd>
            </div>
            <div>
              <dt class="mono-meta">GRADUATE EDUCATION</dt>
              <dd>M.Eng. Materials Science &amp; Engineering + Data Science, UC Berkeley</dd>
            </div>
            <div>
              <dt class="mono-meta">UNDERGRADUATE EDUCATION</dt>
              <dd>B.S. Chemical Engineering (Minor: CS), UC San Diego</dd>
            </div>
            <div>
              <dt class="mono-meta">PRIMARY CONTACT</dt>
              <dd><a href={`mailto:${siteMetadata.email}`} style="color: var(--accent-primary);">{siteMetadata.email}</a></dd>
            </div>
            <div>
              <dt class="mono-meta">GITHUB</dt>
              <dd>
                <a href={siteMetadata.githubUrl} target="_blank" rel="noopener noreferrer" style="color: var(--accent-primary);">
                  github.com/{siteMetadata.githubUsername} ↗
                </a>
              </dd>
            </div>
          </dl>

          <div style="display: flex; flex-direction: column; gap: 0.6rem; margin-top: 1.25rem;">
            <a href="/cv/" class="btn btn-primary" style="width: 100%;">View Full Resume / CV</a>
            <a href="/letters/" class="btn btn-secondary" style="width: 100%;">Recommendation Letters</a>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <!-- Education Section -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">
          <span class="eyebrow-dot" aria-hidden="true"></span>
          <span>02 // ACADEMIC TRAINING</span>
        </span>
        <h2 class="section-title">Education</h2>
        <p class="lead-text">
          Grounded in chemical and materials engineering with formal specialization in data science, algorithms, and computational modeling.
        </p>
      </div>

      <div class="grid-2">
        {
          educationList.map((edu) => (
            <article class="surface-card edu-card">
              <div class="edu-card-header">
                <span class="tag tag-accent">{edu.graduationDate}</span>
                {edu.honorsOrGpa && <span class="mono-meta">{edu.honorsOrGpa}</span>}
              </div>
              <h3 class="edu-inst">{edu.institution}</h3>
              <p class="edu-degree">{edu.degree}</p>
              <p class="mono-meta" style="margin-bottom: 1rem;">
                {edu.concentrationOrMinor} &middot; {edu.location}
              </p>

              <ul class="edu-focus-list">
                {edu.focusAreas.map((area) => (
                  <li>{area}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Technical Competencies -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">
          <span class="eyebrow-dot" aria-hidden="true"></span>
          <span>03 // TECHNICAL CAPABILITIES</span>
        </span>
        <h2 class="section-title">Core Engineering &amp; Scientific Stack</h2>
      </div>

      <div class="grid-2">
        {
          skillGroups.map((group) => (
            <div class="surface-card">
              <span class="mono-meta">{group.code}</span>
              <h3 style="font-family: var(--font-serif); font-size: 1.45rem; font-weight: 400; margin: 0.25rem 0 0.5rem;">
                {group.category}
              </h3>
              <p style="font-size: 0.9rem; color: var(--text-secondary); margin-bottom: 1rem;">
                {group.description}
              </p>
              <div style="display: flex; flex-wrap: wrap; gap: 0.45rem;">
                {group.skills.map((s) => (
                  <span class:list={['tag', { 'tag-accent': s.tier === 'Primary' }]}>{s.name}</span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  @media (min-width: 980px) {
    .about-grid {
      grid-template-columns: 1.45fr 0.85fr;
      gap: 3rem;
    }
  }

  .about-prose {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .prose-paragraph {
    font-size: 1.02rem;
    color: var(--text-secondary);
    line-height: 1.75;
  }

  .editorial-pullquote {
    margin: 0.75rem 0;
    padding: 1.35rem 1.5rem;
    background: var(--bg-elevated);
    border-left: 3px solid var(--accent-primary);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    font-family: var(--font-serif);
    font-size: 1.45rem;
    line-height: 1.35;
    color: var(--text-primary);
  }

  .subsection-heading {
    font-family: var(--font-serif);
    font-size: 1.65rem;
    font-weight: 400;
    margin-top: 1rem;
    color: var(--text-primary);
  }

  .profile-summary-card {
    position: sticky;
    top: 6rem;
  }

  .monogram-banner {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border-subtle);
    margin-bottom: 1.25rem;
  }

  .large-monogram {
    width: 3.4rem;
    height: 3.4rem;
    border-radius: 12px;
    background: var(--accent-surface);
    border: 1px solid var(--accent-border);
    color: var(--accent-primary);
    font-family: var(--font-mono);
    font-size: 1.25rem;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .sidebar-facts {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .sidebar-facts div {
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .sidebar-facts dd {
    font-size: 0.9rem;
    color: var(--text-primary);
    margin-top: 0.2rem;
  }

  .edu-card {
    display: flex;
    flex-direction: column;
  }

  .edu-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.85rem;
  }

  .edu-inst {
    font-family: var(--font-serif);
    font-size: 1.65rem;
    font-weight: 400;
    color: var(--text-primary);
  }

  .edu-degree {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-secondary);
    margin: 0.25rem 0;
  }

  .edu-focus-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    margin-top: auto;
    padding-top: 0.9rem;
    border-top: 1px solid var(--border-subtle);
  }

  .edu-focus-list li {
    position: relative;
    padding-left: 1.1rem;
    font-size: 0.88rem;
    color: var(--text-secondary);
  }

  .edu-focus-list li::before {
    content: '▹';
    position: absolute;
    left: 0;
    color: var(--accent-primary);
  }
</style>
