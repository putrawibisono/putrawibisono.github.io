---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteMetadata } from '../data/profile';

const inquiryTopics = [
  {
    code: 'CORR // 01',
    topic: 'Agricultural Technology & Demonstration Trials',
    detail: 'Collaborations regarding soil IoT telemetry, satellite field characterization, organic fertilizer trials, or institutional reporting.',
    subject: 'Agri-Tech Collaboration Inquiry — Agros Industry',
  },
  {
    code: 'CORR // 02',
    topic: 'Data Engineering, Battery Telemetry & ML Advisory',
    detail: 'Technical correspondence concerning distributed data architectures, electrochemical formation pipelines, or physical systems ML.',
    subject: 'Engineering / Advisory Correspondence',
  },
  {
    code: 'CORR // 03',
    topic: 'Academic & Professional Recommendation Letters',
    detail: 'Reference requests from former UC San Diego students (CSE 8A / CSE 20) or colleagues from Stripe, Tesla, and Agros Industry.',
    subject: 'Recommendation Letter Request',
    internalHref: '/letters/',
  },
  {
    code: 'CORR // 04',
    topic: 'Monograph Source Code & Simulation Archives',
    detail: 'Requests for view-only access to academic repositories (e.g., Gitlet, MATLAB/COMSOL reactor models, or acoustic scanning code).',
    subject: 'Archival Code / Monograph Inquiry',
  },
];
---

<BaseLayout
  title="VIII. Correspondence & Directory — Putra Wibisono"
  description="Direct email correspondence, verified GitHub profiles, and inquiry routing for Putra Wibisono."
>
  <article>
    <div class="reading-with-margin">
      <div class="main-reading-col">
        <span class="rubric-mark">§ VIII. Correspondence · Fol. 08</span>
        <h1 class="monograph-title">
          Direct <em>Correspondence</em> &amp; Directory.
        </h1>

        <div class="essay-prose" style="margin-top: 1.5rem;">
          <p class="dropcap">
            Whether you are an agronomist or institutional partner interested in field trials with Agros Industry, an engineer or researcher discussing distributed telemetry and battery formation systems, or a former student requesting a letter of reference, direct electronic mail is the fastest and most reliable channel.
          </p>
        </div>

        <!-- Primary Dispatch Card -->
        <div class="dispatch-ledger">
          <div class="dispatch-row">
            <span class="mono-cite" style="color: var(--rubric);">Primary Electronic Mail</span>
            <div class="dispatch-address-group">
              <a id="primary-email-link" href={`mailto:${siteMetadata.email}`} class="dispatch-email">
                {siteMetadata.email}
              </a>
              <button type="button" id="copy-email-btn" class="folio-action" data-email={siteMetadata.email}>
                Copy Address
              </button>
            </div>
          </div>

          <div class="dispatch-row">
            <span class="mono-cite">Geographic Base</span>
            <span class="sans-note" style="color: var(--ink);">{siteMetadata.location}</span>
          </div>

          <div class="dispatch-row">
            <span class="mono-cite">Academic Affiliation</span>
            <span class="sans-note" style="color: var(--ink);">{siteMetadata.affiliation}</span>
          </div>

          <div class="dispatch-row">
            <span class="mono-cite">Verified GitHub Profiles</span>
            <div style="display: flex; flex-wrap: wrap; gap: 1.25rem;">
              <a href={siteMetadata.githubUrl} target="_blank" rel="noopener noreferrer" class="text-link mono-cite">
                github.com/EytaW (Primary Engineering Profile) ↗
              </a>
              <a href={siteMetadata.repoGithubUrl} target="_blank" rel="noopener noreferrer" class="text-link mono-cite">
                github.com/putrawibisono (Publication Repository) ↗
              </a>
            </div>
          </div>
        </div>
      </div>

      <aside class="margin-column" aria-label="Correspondence notes">
        <div class="sidenote-block">
          <span class="sidenote-label">Verification Note</span>
          <p>
            Only verified profiles and addresses documented in the repository record are listed here. No third-party tracking forms or external CRM widgets are used on this domain.
          </p>
        </div>

        <div class="sidenote-block">
          <span class="sidenote-label">Recommendation Protocol</span>
          <p>
            Before requesting a reference letter, please review the five required dossier items in <a href="/letters/" class="text-link">§ VI. Recommendation Letters →</a>
          </p>
        </div>
      </aside>
    </div>

    <!-- Subject-Line Routing Ledger -->
    <section class="ledger-section" aria-labelledby="routing-heading">
      <div class="ledger-header">
        <div>
          <span class="rubric-mark" style="margin-bottom: 0.2rem;">Index of Inquiries</span>
          <h2 id="routing-heading" class="section-heading">Structured Subject-Line Routing</h2>
        </div>
        <span class="mono-cite">Direct Mailto Dispatch</span>
      </div>

      <table class="ledger-table">
        <thead>
          <tr>
            <th style="width: 16%;">Ref.</th>
            <th style="width: 34%;">Subject Matter</th>
            <th style="width: 34%;">Scope</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          {inquiryTopics.map((item) => (
            <tr>
              <td class="mono-cite" style="color: var(--rubric);">{item.code}</td>
              <td>
                <strong style="color: var(--ink); font-weight: 600;">{item.topic}</strong>
              </td>
              <td class="sans-note">{item.detail}</td>
              <td>
                {item.internalHref ? (
                  <a href={item.internalHref} class="text-link mono-cite">
                    Open Protocol →
                  </a>
                ) : (
                  <a
                    href={`mailto:${siteMetadata.email}?subject=${encodeURIComponent(item.subject)}`}
                    class="text-link mono-cite"
                  >
                    Draft Email →
                  </a>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  </article>
</BaseLayout>

<script>
  function initCopyAddress() {
    const btn = document.getElementById('copy-email-btn');
    if (!btn) return;

    btn.addEventListener('click', async () => {
      const email = btn.getAttribute('data-email') || 'president@agrosindustry.com';
      try {
        await navigator.clipboard.writeText(email);
        const original = btn.textContent;
        btn.textContent = 'Copied to Clipboard ✓';
        setTimeout(() => {
          btn.textContent = original;
        }, 2000);
      } catch {
        window.location.href = `mailto:${email}`;
      }
    });
  }

  initCopyAddress();
  document.addEventListener('astro:after-swap', initCopyAddress);
</script>

<style>
  .dispatch-ledger {
    margin-top: 2rem;
    border-top: 1px solid var(--rule-strong);
    border-bottom: 1px solid var(--rule-strong);
  }

  .dispatch-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.35rem;
    padding: 0.95rem 0;
    border-bottom: 1px solid var(--rule);
    align-items: baseline;
  }

  .dispatch-row:last-child {
    border-bottom: none;
  }

  @media (min-width: 680px) {
    .dispatch-row {
      grid-template-columns: 190px 1fr;
      gap: 1.5rem;
    }
  }

  .dispatch-address-group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }

  .dispatch-email {
    font-family: var(--font-serif);
    font-size: clamp(1.25rem, 2.2vw, 1.6rem);
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--rubric);
    text-underline-offset: 4px;
  }

  .dispatch-email:hover {
    color: var(--rubric);
  }
</style>
