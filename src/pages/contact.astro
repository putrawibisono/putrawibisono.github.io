---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteMetadata } from '../data/profile';

const inquiryTopics = [
  {
    topic: 'Data Engineering, Battery Telemetry & Materials Science',
    detail: 'Technical correspondence regarding distributed data pipelines, electrochemical cell formation analytics, or physical systems ML.',
    subject: 'Engineering / Technical Correspondence',
  },
  {
    topic: 'Business Operations & Strategy (Family-Owned Enterprise)',
    detail: "Inquiries related to business operations and strategic initiatives at my family's agricultural enterprise.",
    subject: 'Business Operations & Strategy Inquiry',
  },
  {
    topic: 'Academic & Professional Recommendation Letters',
    detail: 'Reference requests from former colleagues and collaborators at Tesla, Rivian, ATOM Science, UC Berkeley, UC San Diego, or family enterprise operations.',
    subject: 'Recommendation Letter Request',
    internalHref: '/letters/',
  },
  {
    topic: 'Academic Project Source Code & Simulation Reports',
    detail: 'Requests for view-only access to individual academic project code (Gitlet, LPCVD COMSOL/MATLAB models, or acoustic scanning code).',
    subject: 'Project Source Code Inquiry',
  },
];
---

<BaseLayout
  title="Contact — Putra Wibisono"
  description="Direct email address (putrawibisonos@gmail.com) and GitHub profiles for Putra Wibisono."
>
  <article>
    <div class="reading-with-margin">
      <div class="main-reading-col">
        <span class="rubric-mark">VII. Contact</span>
        <h1 class="monograph-title">
          Get in <em>Touch</em>.
        </h1>

        <div class="essay-prose" style="margin-top: 1.25rem;">
          <p class="essay-lead">
            Email is the best way to reach me for engineering discussions, business operations inquiries, or recommendation letter requests.
          </p>
        </div>

        <!-- Primary Dispatch Card -->
        <div class="dispatch-ledger">
          <div class="dispatch-row">
            <span class="mono-cite" style="color: var(--rubric); font-weight: 500;">Email</span>
            <div class="dispatch-address-group">
              <a id="primary-email-link" href={`mailto:${siteMetadata.email}`} class="dispatch-email">
                {siteMetadata.email}
              </a>
              <button type="button" id="copy-email-btn" class="folio-action" data-email={siteMetadata.email}>
                Copy Email
              </button>
            </div>
          </div>

          <div class="dispatch-row">
            <span class="mono-cite">Current Role</span>
            <span class="sans-note" style="color: var(--ink);">{siteMetadata.currentRoleTag}</span>
          </div>

          <div class="dispatch-row">
            <span class="mono-cite">Education</span>
            <span class="sans-note" style="color: var(--ink);">{siteMetadata.affiliation}</span>
          </div>

          <div class="dispatch-row">
            <span class="mono-cite">Location</span>
            <span class="sans-note" style="color: var(--ink);">{siteMetadata.location}</span>
          </div>

          <div class="dispatch-row">
            <span class="mono-cite">GitHub Profiles</span>
            <div style="display: flex; flex-wrap: wrap; gap: 1.25rem;">
              <a href={siteMetadata.githubUrl} target="_blank" rel="noopener noreferrer" class="text-link mono-cite">
                github.com/EytaW (Primary Profile) ↗
              </a>
              <a href={siteMetadata.repoGithubUrl} target="_blank" rel="noopener noreferrer" class="text-link mono-cite">
                github.com/putrawibisono (Website Repository) ↗
              </a>
            </div>
          </div>
        </div>
      </div>

      <aside class="margin-column" aria-label="Correspondence notes">
        <div class="sidenote-block">
          <span class="sidenote-label">Recommendation Letters</span>
          <p>
            If you are requesting a reference letter, please check the required details and 3–4 week lead time on the <a href="/letters/" class="text-link">Reference Letters page →</a>
          </p>
        </div>
      </aside>
    </div>

    <!-- Subject-Line Routing Ledger -->
    <section class="ledger-section" aria-labelledby="routing-heading">
      <div class="ledger-header">
        <h2 id="routing-heading" class="section-heading">Direct Email Routing by Topic</h2>
      </div>

      <table class="ledger-table">
        <thead>
          <tr>
            <th style="width: 36%;">Topic</th>
            <th style="width: 46%;">Scope</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          {inquiryTopics.map((item) => (
            <tr>
              <td>
                <strong style="color: var(--ink); font-weight: 600;">{item.topic}</strong>
              </td>
              <td class="sans-note">{item.detail}</td>
              <td>
                {item.internalHref ? (
                  <a href={item.internalHref} class="text-link mono-cite">
                    Open Protocol →
                  </a>
                ) : (
                  <a
                    href={`mailto:${siteMetadata.email}?subject=${encodeURIComponent(item.subject)}`}
                    class="text-link mono-cite"
                  >
                    Draft Email →
                  </a>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  </article>
</BaseLayout>

<script>
  function initCopyAddress() {
    const btn = document.getElementById('copy-email-btn');
    if (!btn) return;

    btn.addEventListener('click', async () => {
      const email = btn.getAttribute('data-email') || 'putrawibisonos@gmail.com';
      try {
        await navigator.clipboard.writeText(email);
        const original = btn.textContent;
        btn.textContent = 'Copied ✓';
        setTimeout(() => {
          btn.textContent = original;
        }, 2000);
      } catch {
        window.location.href = `mailto:${email}`;
      }
    });
  }

  initCopyAddress();
  document.addEventListener('astro:after-swap', initCopyAddress);
</script>

<style>
  .dispatch-ledger {
    margin-top: 1.75rem;
    border-top: 1.5px solid var(--rule-strong);
    border-bottom: 1.5px solid var(--rule-strong);
  }

  .dispatch-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.35rem;
    padding: 0.95rem 0;
    border-bottom: 1px solid var(--rule);
    align-items: baseline;
  }

  .dispatch-row:last-child {
    border-bottom: none;
  }

  @media (min-width: 680px) {
    .dispatch-row {
      grid-template-columns: 195px minmax(0, 1fr);
      gap: 1.5rem;
    }
  }

  .dispatch-address-group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }

  .dispatch-email {
    font-family: var(--font-serif);
    font-size: clamp(1.25rem, 2.2vw, 1.6rem);
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--rubric);
    text-underline-offset: 4px;
  }

  .dispatch-email:hover {
    color: var(--rubric);
  }
</style>
