---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteMetadata } from '../data/profile';

const inquiryTemplates = [
  {
    code: 'INQ // 01',
    title: 'Agricultural Technology & Field Partnerships',
    description:
      'Collaborations on IoT soil monitoring, organic fertilizer demonstration trials, satellite analytics, or government/institutional reporting.',
    subject: 'Agri-Tech Partnership & Collaboration Inquiry',
  },
  {
    code: 'INQ // 02',
    title: 'Data Engineering, ML Systems & Advisory',
    description:
      'Technical architecture consulting, distributed pipeline engineering, battery/manufacturing telemetry, or speaking inquiries.',
    subject: 'Technical Advisory / Data Engineering Inquiry',
  },
  {
    code: 'INQ // 03',
    title: 'Recommendation Letter Requests',
    description:
      'For former colleagues at Stripe/Tesla, UCSD CSE students, and project collaborators. Please review the required packet first.',
    subject: 'Recommendation Letter Request',
    linkOverride: '/letters/',
  },
];
---

<BaseLayout
  title="Contact & Verified Channels"
  description="Get in touch with Putra Wibisono for agricultural technology partnerships, data engineering collaborations, or recommendation letters."
  canonicalPath="/contact/"
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">
        <span class="eyebrow-dot" aria-hidden="true"></span>
        <span>07 // DIRECT COMMUNICATION &amp; PROFILES</span>
      </span>
      <h1 class="page-title" style="margin-top: 0.6rem;">
        Get in Touch
      </h1>
      <p class="lead-text" style="margin-top: 0.85rem;">
        Whether you are exploring agricultural technology partnerships, discussing distributed data systems, or requesting a recommendation letter, reach out directly via email.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container contact-grid">
      <!-- Primary Direct Channel Card -->
      <div class="surface-card primary-contact-card">
        <span class="mono-meta">PRIMARY VERIFIED EMAIL</span>
        <h2 class="email-display">{siteMetadata.email}</h2>
        <p style="color: var(--text-secondary); font-size: 0.95rem; margin-bottom: 1.5rem;">
          Direct inbox for Agros Industry (Agricultural Technologies), engineering collaborations, and academic correspondence.
        </p>

        <div class="contact-btn-row">
          <a href={`mailto:${siteMetadata.email}`} class="btn btn-primary">
            <span>Open Email Client →</span>
          </a>
          <button type="button" id="copy-email-btn" class="btn btn-secondary" data-email={siteMetadata.email}>
            <span id="copy-email-label">Copy Email Address</span>
          </button>
        </div>

        <div class="verified-profiles">
          <p class="mono-meta" style="margin-bottom: 0.75rem;">VERIFIED EXTERNAL PROFILES</p>
          <div class="profile-links-stack">
            <a
              href={siteMetadata.githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="profile-link-row"
            >
              <div>
                <strong>GitHub — @{siteMetadata.githubUsername}</strong>
                <p class="mono-meta">Primary software &amp; data engineering profile</p>
              </div>
              <span class="mono-meta" style="color: var(--accent-primary);">github.com/EytaW ↗</span>
            </a>

            <a
              href={siteMetadata.repoGithubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="profile-link-row"
            >
              <div>
                <strong>GitHub — @putrawibisono</strong>
                <p class="mono-meta">Web publication &amp; repository host</p>
              </div>
              <span class="mono-meta" style="color: var(--accent-primary);">github.com/putrawibisono ↗</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Structured Inquiry Pathways -->
      <div class="inquiry-column">
        <p class="mono-meta" style="margin-bottom: 0.75rem;">QUICK INQUIRY PATHWAYS</p>
        <div class="inquiry-stack">
          {
            inquiryTemplates.map((item) => (
              <div class="surface-card inquiry-card">
                <span class="mono-meta">{item.code}</span>
                <h3 style="font-family: var(--font-serif); font-size: 1.4rem; font-weight: 400; margin: 0.25rem 0 0.4rem;">
                  {item.title}
                </h3>
                <p style="font-size: 0.9rem; color: var(--text-secondary); margin-bottom: 1rem;">
                  {item.description}
                </p>
                {item.linkOverride ? (
                  <a href={item.linkOverride} class="btn btn-ghost">
                    Open Recommendation Letter Checklist →
                  </a>
                ) : (
                  <a
                    href={`mailto:${siteMetadata.email}?subject=${encodeURIComponent(item.subject)}`}
                    class="btn btn-ghost"
                  >
                    Compose: "{item.subject}" →
                  </a>
                )}
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    var copyBtn = document.getElementById('copy-email-btn');
    var label = document.getElementById('copy-email-label');
    if (copyBtn && label) {
      copyBtn.addEventListener('click', function () {
        var email = copyBtn.getAttribute('data-email') || 'president@agrosindustry.com';
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(email).then(function () {
            label.textContent = 'Copied: ' + email;
            setTimeout(function () {
              label.textContent = 'Copy Email Address';
            }, 2500);
          });
        }
      });
    }
  })();
</script>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: start;
  }

  @media (min-width: 960px) {
    .contact-grid {
      grid-template-columns: 1.15fr 1fr;
    }
  }

  .primary-contact-card {
    display: flex;
    flex-direction: column;
  }

  .email-display {
    font-family: var(--font-mono);
    font-size: clamp(1.15rem, 2.2vw, 1.55rem);
    font-weight: 600;
    color: var(--accent-primary);
    margin: 0.5rem 0 0.75rem;
    word-break: break-all;
  }

  .contact-btn-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .verified-profiles {
    margin-top: 1.5rem;
  }

  .profile-links-stack {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .profile-link-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    padding: 0.95rem 1.1rem;
    border-radius: var(--radius-sm);
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
  }

  .profile-link-row:hover {
    border-color: var(--accent-border);
  }

  .inquiry-stack {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
</style>
