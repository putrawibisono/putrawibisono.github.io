---
import BaseLayout from '../layouts/BaseLayout.astro';
import { teachingCourses } from '../data/profile';
---

<BaseLayout
  title="V. Academic Instruction — Putra Wibisono"
  description="Undergraduate computer science instruction at UC San Diego (CSE 8A: Introduction to Programming in Python and CSE 20: Discrete Mathematics)."
>
  <article>
    <div class="reading-with-margin">
      <div class="main-reading-col">
        <span class="rubric-mark">§ V. Academic Instruction · Fol. 05</span>
        <h1 class="monograph-title">
          University <em>Teaching</em> &amp; Course Syllabi.
        </h1>

        <div class="essay-prose" style="margin-top: 1.5rem;">
          <p class="dropcap">
            Alongside undergraduate chemical engineering coursework and nanoengineering battery research at the University of California, San Diego, I contributed to instruction in the Department of Computer Science and Engineering (CSE). Teaching introductory programming and discrete mathematics reinforced a conviction that carries throughout my engineering work: complex computational invariants should be explainable from first principles.
          </p>
        </div>
      </div>

      <aside class="margin-column" aria-label="Instructional notes">
        <div class="sidenote-block">
          <span class="sidenote-label">Departmental Affiliation</span>
          <p>
            Department of Computer Science and Engineering (CSE), University of California, San Diego · La Jolla, CA.
          </p>
        </div>

        <div class="sidenote-block">
          <span class="sidenote-label">Student Recommendations</span>
          <p>
            Former students from CSE 8A or CSE 20 applying to graduate programs, research fellowships, or software engineering roles may consult <a href="/letters/" class="text-link">§ VI. Recommendation Letters →</a>
          </p>
        </div>
      </aside>
    </div>

    <!-- Course Syllabi Ledger -->
    {teachingCourses.map((course, idx) => (
      <section class="ledger-section" aria-labelledby={`course-${idx}-heading`}>
        <div class="ledger-header">
          <div>
            <span class="rubric-mark" style="margin-bottom: 0.2rem;">
              Course Record 0{idx + 1} · {course.code} ({course.type})
            </span>
            <h2 id={`course-${idx}-heading`} class="section-heading">
              {course.code}: {course.title}
            </h2>
          </div>
          <span class="mono-cite">{course.institution} · {course.department}</span>
        </div>

        <div class="reading-with-margin" style="margin-top: 1rem;">
          <div>
            <p class="essay-prose" style="color: var(--ink-secondary); margin-bottom: 1.25rem;">
              {course.summary}
            </p>

            <span class="sidenote-label" style="display: block; margin-bottom: 0.65rem;">
              Documented Course Learning Outcomes
            </span>
            <ol class="syllabus-outcomes">
              {course.learningOutcomes.map((outcome, oIdx) => (
                <li>
                  <span class="mono-cite" style="color: var(--rubric);">0{oIdx + 1}.</span>
                  <span class="sans-note" style="color: var(--ink); font-size: 0.85rem;">{outcome}</span>
                </li>
              ))}
            </ol>
          </div>

          <aside class="margin-column">
            <div class="sidenote-block">
              <span class="sidenote-label">Course Designation</span>
              <p><strong style="color: var(--ink);">{course.code}</strong> · {course.type}</p>
            </div>
            <div class="sidenote-block">
              <span class="sidenote-label">Core Curriculum &amp; Tools</span>
              <p>{course.toolsAndTopics.join(' · ')}</p>
            </div>
          </aside>
        </div>
      </section>
    ))}
  </article>
</BaseLayout>

<style>
  .syllabus-outcomes {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    border-top: 1px solid var(--rule);
    padding-top: 0.85rem;
  }

  .syllabus-outcomes li {
    display: grid;
    grid-template-columns: 2rem 1fr;
    align-items: baseline;
    padding-bottom: 0.7rem;
    border-bottom: 1px dotted var(--rule-dotted);
  }
</style>
