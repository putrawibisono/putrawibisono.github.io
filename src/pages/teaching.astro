---
import BaseLayout from '../layouts/BaseLayout.astro';
import { teachingCourses } from '../data/profile';
---

<BaseLayout
  title="Archival Teaching Files Audit (Unverified) — Putra Wibisono"
  description="Provenance audit of legacy _teaching/2014-spring-teaching-1.md and _teaching/2015-spring-teaching-2.md files inherited from the AcademicPages template."
>
  <article>
    <header style="border-bottom: 1.5px solid var(--rule-strong); padding-bottom: 1.5rem; margin-bottom: 2.25rem;">
      <span class="rubric-mark">Archival Content Provenance Audit · Unverified Template Files</span>
      <h1 class="monograph-title">
        Legacy <em>Teaching</em> Files Audit (UC San Diego CSE).
      </h1>
      <p class="sans-note" style="max-width: 68ch; margin-top: 0.75rem;">
        <strong>Provenance Notice:</strong> The two files in the legacy repository’s <code>_teaching/</code> directory (<code>2014-spring-teaching-1.md</code> and <code>2015-spring-teaching-2.md</code>) were inherited from the upstream AcademicPages template and retain template demonstration headings and placeholder text. Because neither course appears in the December 2024 CV PDF (<code>files/cvsreal.pdf</code>), these entries are classified as <strong>Unverified — Modified AcademicPages Template Files</strong> and must not be treated as independent verification of UCSD teaching appointments unless confirmed.
      </p>
    </header>

    <!-- Course Records -->
    {teachingCourses.map((course, idx) => (
      <section class:list={[{ 'ledger-section': idx > 0 }]} aria-labelledby={`course-${idx}-heading`}>
        <div class="ledger-header">
          <div>
            <span class="rubric-mark" style="margin-bottom: 0.2rem;">
              {course.code} · {course.provenanceStatus}
            </span>
            <h2 id={`course-${idx}-heading`} class="section-heading">
              {course.code}: {course.title}
            </h2>
          </div>
          <span class="mono-cite">{course.templateFilename}</span>
        </div>

        <div class="reading-with-margin" style="margin-top: 1rem;">
          <div>
            <p class="essay-prose" style="color: var(--ink-secondary); margin-bottom: 1.25rem;">
              {course.summary}
            </p>

            {course.learningOutcomes.length > 0 && (
              <>
                <span class="sidenote-label" style="display: block; margin-bottom: 0.65rem;">
                  Catalog Learning Outcomes Pasted into {course.templateFilename}
                </span>
                <ol class="syllabus-outcomes">
                  {course.learningOutcomes.map((outcome, oIdx) => (
                    <li>
                      <span class="mono-cite" style="color: var(--rubric);">0{oIdx + 1}.</span>
                      <span class="sans-note" style="color: var(--ink); font-size: 0.85rem;">{outcome}</span>
                    </li>
                  ))}
                </ol>
              </>
            )}

            <div class="source-note-box" style="margin-top: 1.25rem;">
              <span class="sidenote-label">Forensic Git Diff Note</span>
              <p class="sans-note" style="margin-top: 0.25rem;">{course.sourceNote}</p>
            </div>
          </div>

          <aside class="margin-column">
            <div class="sidenote-block">
              <span class="sidenote-label">Verification Status</span>
              <p><strong style="color: var(--rubric);">{course.provenanceStatus}</strong></p>
            </div>
            <div class="sidenote-block">
              <span class="sidenote-label">Template Source File</span>
              <p><code>{course.templateFilename}</code></p>
            </div>
            <div class="sidenote-block">
              <span class="sidenote-label">Verified UCSD Academic Role</span>
              <p>
                Per <code>files/cvsreal.pdf</code>, Putra Wibisono’s verified UCSD academic appointment was <strong>Research Assistant — Battery Engineering, Department of Nanoengineering (Sep 2020 – Jun 2021)</strong>.
              </p>
            </div>
          </aside>
        </div>
      </section>
    ))}
  </article>
</BaseLayout>

<style>
  .syllabus-outcomes {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    border-top: 1px solid var(--rule);
    padding-top: 0.85rem;
  }

  .syllabus-outcomes li {
    display: grid;
    grid-template-columns: 2rem 1fr;
    align-items: baseline;
    padding-bottom: 0.7rem;
    border-bottom: 1px dotted var(--rule-dotted);
  }

  .source-note-box {
    background: var(--paper-tint);
    border-left: 2px solid var(--rubric);
    padding: 0.95rem 1.15rem;
  }
</style>
