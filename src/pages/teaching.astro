---
import BaseLayout from '../layouts/BaseLayout.astro';
import { teachingCourses } from '../data/profile';
---

<BaseLayout
  title="Academic Instruction (UC San Diego CSE) — Putra Wibisono"
  description="Undergraduate computer science teaching record at UC San Diego (CSE 8A and CSE 20)."
>
  <article>
    <header style="border-bottom: 1.5px solid var(--rule-strong); padding-bottom: 1.5rem; margin-bottom: 2.25rem;">
      <span class="rubric-mark">V. Academic Instruction</span>
      <h1 class="monograph-title">
        University <em>Teaching</em> at UC San Diego.
      </h1>
      <p class="sans-note" style="max-width: 66ch; margin-top: 0.75rem;">
        Alongside chemical engineering studies and nanoengineering battery research at the University of California, San Diego, I contributed to undergraduate instruction in the Department of Computer Science and Engineering (CSE).
      </p>
    </header>

    <!-- Course Records -->
    {teachingCourses.map((course, idx) => (
      <section class:list={[{ 'ledger-section': idx > 0 }]} aria-labelledby={`course-${idx}-heading`}>
        <div class="ledger-header">
          <div>
            <span class="rubric-mark" style="margin-bottom: 0.2rem;">
              {course.code} · {course.type}
            </span>
            <h2 id={`course-${idx}-heading`} class="section-heading">
              {course.code}: {course.title}
            </h2>
          </div>
          <span class="mono-cite">{course.institution} · {course.department}</span>
        </div>

        <div class="reading-with-margin" style="margin-top: 1rem;">
          <div>
            <p class="essay-prose" style="color: var(--ink-secondary); margin-bottom: 1.25rem;">
              {course.summary}
            </p>

            {course.learningOutcomes.length > 0 && (
              <>
                <span class="sidenote-label" style="display: block; margin-bottom: 0.65rem;">
                  Documented Course Learning Outcomes
                </span>
                <ol class="syllabus-outcomes">
                  {course.learningOutcomes.map((outcome, oIdx) => (
                    <li>
                      <span class="mono-cite" style="color: var(--rubric);">0{oIdx + 1}.</span>
                      <span class="sans-note" style="color: var(--ink); font-size: 0.85rem;">{outcome}</span>
                    </li>
                  ))}
                </ol>
              </>
            )}

            {course.sourceNote && (
              <div class="source-note-box">
                <span class="sidenote-label">Archival Source Note</span>
                <p class="sans-note" style="margin-top: 0.25rem;">{course.sourceNote}</p>
              </div>
            )}
          </div>

          <aside class="margin-column">
            <div class="sidenote-block">
              <span class="sidenote-label">Department</span>
              <p>{course.department}, {course.location}</p>
            </div>
            <div class="sidenote-block">
              <span class="sidenote-label">Topics</span>
              <p>{course.toolsAndTopics.join(' · ')}</p>
            </div>
            <div class="sidenote-block">
              <span class="sidenote-label">Student Reference Letters</span>
              <p>
                Former students requesting graduate school or employment references may review the <a href="/letters/" class="text-link">Reference Letter Protocol →</a>
              </p>
            </div>
          </aside>
        </div>
      </section>
    ))}
  </article>
</BaseLayout>

<style>
  .syllabus-outcomes {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    border-top: 1px solid var(--rule);
    padding-top: 0.85rem;
  }

  .syllabus-outcomes li {
    display: grid;
    grid-template-columns: 2rem 1fr;
    align-items: baseline;
    padding-bottom: 0.7rem;
    border-bottom: 1px dotted var(--rule-dotted);
  }

  .source-note-box {
    background: var(--paper-tint);
    border-left: 2px solid var(--rubric);
    padding: 0.95rem 1.15rem;
  }
</style>
