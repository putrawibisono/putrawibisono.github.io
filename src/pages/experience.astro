---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
import { experienceList, educationList, skillGroups } from '../data/profile';
---

<BaseLayout
  title="III. Work & Research Dossier — Putra Wibisono"
  description="Chronological engineering and research record across Agros Industry, Stripe, Tesla, ATOM Science, Rivian, and UC San Diego."
>
  <article>
    <div class="reading-with-margin">
      <div class="main-reading-col">
        <span class="rubric-mark">§ III. Chronological Record · Fol. 03</span>
        <h1 class="monograph-title">
          Work &amp; <em>Research Dossier</em>.
        </h1>

        <div class="essay-prose" style="margin-top: 1.5rem;">
          <p class="dropcap">
            Over the past five years, my engineering work has moved progressively closer to the boundary where digital software systems meet physical chemistry and agronomy. From coin-cell assembly inside argon glove boxes at UC San Diego and Solid Electrolyte Interphase (SEI) formation protocols at Rivian, to multi-gigafactory 4680 battery telemetry at Tesla and high-reliability enterprise data platforms at Stripe, each post has demanded deterministic pipelines built over noisy, real-world measurements.
          </p>
          <p>
            The ledger below documents all six verified appointments in reverse chronological order, together with primary technical deliverables, instrumentation, and software methods.
          </p>
        </div>
      </div>

      <aside class="margin-column" aria-label="Dossier index and verification notes">
        <div class="sidenote-block">
          <span class="sidenote-label">Dossier Scope · 2020–Present</span>
          <p>
            Six primary appointments spanning precision agriculture, financial infrastructure, electric vehicle cell manufacturing, computational drug discovery, and nanoengineering research.
          </p>
        </div>

        <div class="sidenote-block">
          <span class="sidenote-label">Archival Note on Dates</span>
          <p>
            Where exact calendar months were omitted in source records (such as the post-Tesla tenure at Stripe), entries are explicitly annotated rather than estimated.
          </p>
        </div>

        <div class="sidenote-block">
          <span class="sidenote-label">Curriculum Vitae</span>
          <p>
            For a condensed print layout or the archived 2024 engineering resume PDF, consult <a href="/cv/" class="text-link">§ VII. Curriculum Vitae →</a>
          </p>
        </div>
      </aside>
    </div>

    <!-- Chronological Appointments Ledger -->
    <section class="ledger-section" aria-labelledby="appointments-heading">
      <div class="ledger-header">
        <div>
          <span class="rubric-mark" style="margin-bottom: 0.2rem;">Part I · Appointments</span>
          <h2 id="appointments-heading" class="section-heading">Professional &amp; Research Positions</h2>
        </div>
        <span class="mono-cite">6 Verified Entries · Reverse Chronological</span>
      </div>

      <ExperienceTimeline items={experienceList} compact={false} />
    </section>

    <!-- Academic Degrees & Technical Concordance -->
    <section class="ledger-section" aria-labelledby="education-concordance-heading">
      <div class="ledger-header">
        <div>
          <span class="rubric-mark" style="margin-bottom: 0.2rem;">Part II · Academic &amp; Technical Index</span>
          <h2 id="education-concordance-heading" class="section-heading">University Degrees &amp; Domain Concordance</h2>
        </div>
        <a href="/projects/" class="text-link mono-cite">Inspect Technical Monographs →</a>
      </div>

      <table class="ledger-table">
        <thead>
          <tr>
            <th style="width: 22%;">Date / Code</th>
            <th style="width: 34%;">Institution or Domain</th>
            <th>Credential, Focus &amp; Primary Instruments</th>
          </tr>
        </thead>
        <tbody>
          {educationList.map((edu) => (
            <tr>
              <td class="mono-cite" style="color: var(--rubric);">{edu.graduationDate}</td>
              <td>
                <strong style="color: var(--ink); font-weight: 600;">{edu.institution}</strong>
                <div class="mono-cite">{edu.location}</div>
              </td>
              <td>
                <div style="color: var(--ink); font-weight: 500;">{edu.degree}</div>
                <div class="sans-note" style="margin-top: 0.15rem;">
                  {edu.concentrationOrMinor}
                  {edu.honorsOrGpa ? ` · ${edu.honorsOrGpa}` : ''}
                </div>
              </td>
            </tr>
          ))}
          {skillGroups.map((group) => (
            <tr>
              <td class="mono-cite">{group.code}</td>
              <td>
                <strong style="color: var(--ink); font-weight: 600;">{group.category}</strong>
              </td>
              <td>
                <span class="sans-note">{group.skills.map((s) => s.name).join(' · ')}</span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  </article>
</BaseLayout>
