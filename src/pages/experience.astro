---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
import { experienceList, educationList } from '../data/profile';
---

<BaseLayout
  title="Work Experience — Putra Wibisono"
  description="Chronological record of Putra Wibisono's engineering and research work at Tesla, ATOM Science, Rivian, and UC San Diego Nanoengineering, alongside Business Operations & Strategy at a family-owned enterprise."
>
  <article>
    <header style="margin-bottom: 2.25rem;">
      <span class="rubric-mark">III. Work Experience</span>
      <h1 class="monograph-title">
        Engineering, <em>Research</em> &amp; Operations.
      </h1>
      <p class="sans-note" style="max-width: 68ch; margin-top: 0.75rem;">
        Chronological overview of my work in electric-vehicle battery manufacturing, data engineering, computational drug discovery, and materials research, alongside my current role in Business Operations &amp; Strategy at our family-owned enterprise.
      </p>
    </header>

    <!-- At-a-Glance Jump Index -->
    <section class="career-quick-index" aria-label="At-a-glance career jump index">
      <div class="quick-index-header">
        <span class="sidenote-label">Roles (2020 – Present)</span>
        <a href="/cv/" class="text-link mono-cite">Open Printable CV →</a>
      </div>
      <div class="quick-index-grid">
        {
          experienceList.map((exp) => (
            <a href={`#${exp.id}`} class="quick-index-item">
              <span class="mono-cite" style="color: var(--rubric);">{exp.period}</span>
              <strong class="quick-index-org">{exp.organization}</strong>
              <span class="quick-index-role">{exp.role}</span>
            </a>
          ))
        }
      </div>
    </section>

    <!-- Full Experience Timeline -->
    <section style="margin-top: 2.75rem;" aria-labelledby="detailed-record-heading">
      <div class="ledger-header">
        <h2 id="detailed-record-heading" class="section-heading">
          Roles &amp; Key Contributions
        </h2>
        <span class="mono-cite">2020 – Present</span>
      </div>

      <ExperienceTimeline items={experienceList} compact={false} />
    </section>

    <!-- Education Summary Footer Table -->
    <section class="ledger-section" aria-labelledby="exp-edu-heading">
      <div class="ledger-header">
        <h2 id="exp-edu-heading" class="section-heading">Education</h2>
        <a href="/about/" class="text-link mono-cite">More on My Background →</a>
      </div>

      <table class="ledger-table">
        <thead>
          <tr>
            <th style="width: 20%;">Graduation</th>
            <th style="width: 32%;">University</th>
            <th>Degree &amp; Concentration</th>
          </tr>
        </thead>
        <tbody>
          {
            educationList.map((edu) => (
              <tr>
                <td class="mono-cite" style="color: var(--rubric);">{edu.graduationDate}</td>
                <td>
                  <strong style="color: var(--ink); font-weight: 600;">{edu.institution}</strong>
                  <div class="mono-cite">{edu.location}</div>
                </td>
                <td>
                  <div style="color: var(--ink); font-weight: 500;">{edu.degree}</div>
                  <div class="sans-note">
                    {edu.concentrationOrMinor}
                    {edu.honorsOrGpa ? ` · ${edu.honorsOrGpa}` : ''}
                  </div>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </section>
  </article>
</BaseLayout>

<style>
  .career-quick-index {
    background: var(--paper-tint);
    border: 1px solid var(--rule);
    border-top: 2px solid var(--rule-strong);
    padding: 1.15rem 1.35rem;
  }

  .quick-index-header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--rule);
    margin-bottom: 0.95rem;
  }

  .quick-index-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(195px, 1fr));
    gap: 0.9rem 1.25rem;
  }

  .quick-index-item {
    display: flex;
    flex-direction: column;
    gap: 0.12rem;
    padding-right: 0.5rem;
    border-left: 2px solid var(--rule);
    padding-left: 0.65rem;
    transition: border-color 140ms ease;
  }

  .quick-index-item:hover {
    border-left-color: var(--rubric);
  }

  .quick-index-org {
    font-family: var(--font-sans);
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--ink);
  }

  .quick-index-role {
    font-family: var(--font-sans);
    font-size: 0.76rem;
    color: var(--ink-secondary);
  }
</style>
