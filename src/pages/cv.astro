---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  siteMetadata,
  educationList,
  experienceList,
  projectsList,
  additionalEngineeringProjects,
  skillGroups,
  teachingCourses,
} from '../data/profile';

const completedProjects = projectsList.filter(
  (p) => p.statusLabel !== 'Ongoing & Exploratory Initiative'
);
---

<BaseLayout
  title="Curriculum Vitae — Putra Wibisono"
  description="Complete academic and professional Curriculum Vitae of Putra Wibisono (UC Berkeley M.Eng., UC San Diego B.S., Ex-Stripe, Ex-Tesla, Acting President as needed at Family-Owned Agricultural Business)."
>
  <article class="cv-folio">
    <!-- Top Archival Action Bar (Hidden in Print) -->
    <div class="cv-action-bar no-print">
      <div>
        <span class="rubric-mark" style="margin-bottom: 0.2rem;">VII. Curriculum Vitae</span>
        <p class="sans-note" style="font-size: 0.8rem;">
          Updated web edition with print formatting. (Note: the archived 2024 PDF download reflects records through Dec 2024.)
        </p>
      </div>
      <div class="cv-action-buttons">
        <button type="button" id="print-cv-btn" class="folio-action folio-action-rubric">
          Print / Save Current CV as PDF
        </button>
        <a href="/files/cvsreal.pdf" target="_blank" rel="noopener noreferrer" class="folio-action">
          Download Archived 2024 Resume (PDF) ↗
        </a>
      </div>
    </div>

    <!-- Classical Monograph CV Masthead -->
    <header class="cv-masthead">
      <div>
        <h1 class="cv-name">{siteMetadata.name}</h1>
        <p class="cv-subtitle">
          Data Engineer &amp; Materials Scientist (Ex-Stripe, Ex-Tesla) · Acting President (as needed), Family-Owned Agricultural Business
        </p>
      </div>
      <div class="cv-contact-ledger">
        <div><a href={`mailto:${siteMetadata.email}`} class="text-link">{siteMetadata.email}</a></div>
        <div><a href={siteMetadata.siteUrl} class="text-link">putrawibisono.com</a></div>
        <div><a href={siteMetadata.githubUrl} target="_blank" rel="noopener noreferrer" class="text-link">github.com/EytaW</a></div>
        <div>{siteMetadata.location}</div>
      </div>
    </header>

    <!-- I. Education -->
    <section class="cv-section" aria-labelledby="cv-edu">
      <h2 id="cv-edu" class="cv-section-title">I. Education</h2>
      <div class="cv-entries">
        {educationList.map((edu) => (
          <div class="cv-row">
            <div class="cv-left">
              <div class="mono-cite" style="color: var(--rubric); font-weight: 500;">{edu.graduationDate}</div>
              <div class="mono-cite">{edu.location}</div>
            </div>
            <div class="cv-right">
              <div class="cv-entry-header">
                <strong>{edu.institution}</strong>
                {edu.honorsOrGpa && <span class="mono-cite" style="color: var(--ink);">{edu.honorsOrGpa}</span>}
              </div>
              <div class="cv-degree">{edu.degree} — <em>{edu.concentrationOrMinor}</em></div>
              <div class="sans-note" style="font-size: 0.8rem; margin-top: 0.2rem;">
                Focus: {edu.focusAreas.join(' · ')}
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- II. Professional & Research Experience -->
    <section class="cv-section" aria-labelledby="cv-exp">
      <h2 id="cv-exp" class="cv-section-title">II. Professional Experience, Field Stewardship &amp; Research</h2>
      <div class="cv-entries">
        {experienceList.map((exp) => (
          <div class="cv-row">
            <div class="cv-left">
              <div class="mono-cite" style="color: var(--rubric); font-weight: 500;">{exp.period}</div>
              <div class="mono-cite">{exp.location}</div>
              <div class="mono-cite" style="margin-top: 0.15rem;">{exp.statusType}</div>
            </div>
            <div class="cv-right">
              <div class="cv-entry-header">
                <strong>{exp.role}</strong>
                <span class="cv-org">{exp.organization}</span>
              </div>
              {exp.periodNote && (
                <div class="mono-cite" style="margin-top: 0.15rem; margin-bottom: 0.25rem;">
                  {exp.periodNote}
                </div>
              )}
              <ul class="cv-bullets">
                {exp.highlights.map((bullet) => (
                  <li>
                    <strong>{bullet.label}:</strong> {bullet.detail}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- III. Completed Technical Studies & Engineering Projects -->
    <section class="cv-section" aria-labelledby="cv-proj">
      <h2 id="cv-proj" class="cv-section-title">III. Completed Engineering &amp; Research Studies</h2>
      <div class="cv-entries">
        {completedProjects.map((proj) => (
          <div class="cv-row">
            <div class="cv-left">
              <div class="mono-cite">{proj.period}</div>
              <div class="mono-cite">{proj.category}</div>
            </div>
            <div class="cv-right">
              <div class="cv-entry-header">
                <strong>
                  <a href={`/projects/${proj.slug}/`} class="text-link">{proj.title}</a>
                </strong>
                <span class="mono-cite">{proj.organizationOrContext}</span>
              </div>
              <p class="sans-note" style="font-size: 0.82rem; margin-top: 0.2rem;">
                {proj.summary}
              </p>
              <div class="mono-cite" style="margin-top: 0.25rem;">
                Methods: {proj.technologies.join(' · ')}
              </div>
            </div>
          </div>
        ))}
      </div>

      <div style="margin-top: 1.25rem; padding-top: 0.85rem; border-top: 1px dotted var(--rule-dotted);">
        <span class="mono-cite" style="color: var(--rubric); display: block; margin-bottom: 0.35rem;">
          Additional Documented Coursework &amp; Simulation Projects:
        </span>
        <p class="sans-note" style="font-size: 0.8rem;">
          {additionalEngineeringProjects.map((p) => `${p.name} (${p.domain})`).join(' · ')}
        </p>
      </div>
    </section>

    <!-- IV. University Instruction -->
    <section class="cv-section" aria-labelledby="cv-teaching">
      <h2 id="cv-teaching" class="cv-section-title">IV. Academic Instruction</h2>
      <div class="cv-entries">
        {teachingCourses.map((course) => (
          <div class="cv-row">
            <div class="cv-left">
              <div class="mono-cite" style="color: var(--rubric); font-weight: 500;">{course.code}</div>
              <div class="mono-cite">{course.institution}</div>
            </div>
            <div class="cv-right">
              <div class="cv-entry-header">
                <strong>{course.title}</strong>
                <span class="mono-cite">{course.department}</span>
              </div>
              <p class="sans-note" style="font-size: 0.82rem; margin-top: 0.15rem;">
                {course.summary}
              </p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- V. Technical Concordance -->
    <section class="cv-section" aria-labelledby="cv-skills">
      <h2 id="cv-skills" class="cv-section-title">V. Technical Stack &amp; Laboratory Instrumentation</h2>
      <table class="ledger-table">
        <tbody>
          {skillGroups.map((group) => (
            <tr>
              <td style="width: 34%;">
                <strong style="color: var(--ink); font-weight: 600;">{group.category}</strong>
              </td>
              <td class="sans-note">
                {group.skills.join(' · ')}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  </article>
</BaseLayout>

<script>
  function initPrintCv() {
    const printBtn = document.getElementById('print-cv-btn');
    printBtn?.addEventListener('click', () => window.print());
  }
  initPrintCv();
  document.addEventListener('astro:after-swap', initPrintCv);
</script>

<style>
  .cv-action-bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-bottom: 1.5rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--rule);
  }

  .cv-action-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .cv-masthead {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 1.5rem;
    padding-bottom: 1.35rem;
    border-bottom: 2px solid var(--rule-strong);
  }

  .cv-name {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(2rem, 3.2vw, 2.65rem);
    line-height: 1.1;
    color: var(--ink);
  }

  .cv-subtitle {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.02rem;
    color: var(--ink-secondary);
    margin-top: 0.35rem;
    max-width: 58ch;
  }

  .cv-contact-ledger {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.65;
    color: var(--ink-secondary);
    text-align: left;
  }

  @media (min-width: 760px) {
    .cv-contact-ledger {
      text-align: right;
    }
  }

  .cv-section {
    margin-top: 2.25rem;
  }

  .cv-section-title {
    font-family: var(--font-serif);
    font-weight: 400;
    font-style: italic;
    font-size: 1.28rem;
    color: var(--rubric);
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--rule-strong);
    margin-bottom: 1.1rem;
  }

  .cv-entries {
    display: flex;
    flex-direction: column;
    gap: 1.45rem;
  }

  .cv-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.35rem;
  }

  @media (min-width: 720px) {
    .cv-row {
      grid-template-columns: 195px minmax(0, 1fr);
      gap: 1.75rem;
    }
  }

  .cv-entry-header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--font-serif);
    font-size: 1.08rem;
    color: var(--ink);
  }

  .cv-org {
    font-family: var(--font-sans);
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--ink-secondary);
  }

  .cv-degree {
    font-family: var(--font-serif);
    font-size: 0.98rem;
    color: var(--ink);
    margin-top: 0.1rem;
  }

  .cv-bullets {
    list-style: none;
    margin-top: 0.45rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .cv-bullets li {
    position: relative;
    padding-left: 1rem;
    font-family: var(--font-sans);
    font-size: 0.82rem;
    line-height: 1.56;
    color: var(--ink-secondary);
  }

  .cv-bullets li strong {
    color: var(--ink);
    font-weight: 600;
  }

  .cv-bullets li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--rubric);
  }
</style>
