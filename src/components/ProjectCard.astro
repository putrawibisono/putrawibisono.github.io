---
import type { ProjectItem } from '../data/profile';
import SystemDiagram from './SystemDiagram.astro';

export interface Props {
  project: ProjectItem;
  showDiagram?: boolean;
}

const { project, showDiagram = true } = Astro.props;
const isOngoing = project.statusLabel === 'Ongoing & Exploratory Initiative';
---

<article class="monograph-entry" data-category={project.category}>
  <div class="monograph-entry-grid">
    <!-- Left Metadata Margin -->
    <div class="entry-meta-col">
      <div>
        <span class:list={['status-tag', { 'status-tag-rubric': isOngoing }]}>
          {project.statusLabel}
        </span>
      </div>
      <p class="entry-cat" style="margin-top: 0.45rem;">{project.category}</p>
      <p class="mono-cite">{project.organizationOrContext}</p>
      <p class="mono-cite">{project.period}</p>

      <div class="entry-tools-block">
        <span class="sidenote-label">Tools &amp; Methods</span>
        <p class="entry-tools-text">{project.technologies.join(' · ')}</p>
      </div>
    </div>

    <!-- Right Editorial Prose & Figure -->
    <div class="entry-body-col">
      <h3 class="entry-title">
        <a href={`/projects/${project.slug}/`}>{project.title}</a>
      </h3>
      <p class="entry-subtitle">{project.subtitle}</p>

      <p class="entry-summary">{project.summary}</p>

      {
        showDiagram && (
          <div class="entry-figure-wrap">
            <SystemDiagram type={project.diagramType} />
          </div>
        )
      }

      <div class="entry-findings">
        <span class="sidenote-label">
          {isOngoing ? 'Scope & Status Note' : 'Verified Outcomes'}
        </span>
        <ul>
          {project.outcomes.map((outcome) => <li>{outcome}</li>)}
        </ul>
      </div>

      <div class="entry-footer-link">
        <a href={`/projects/${project.slug}/`} class="text-link">
          Inspect Technical Details →
        </a>
      </div>
    </div>
  </div>
</article>
