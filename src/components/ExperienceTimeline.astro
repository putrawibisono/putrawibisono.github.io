---
import type { ExperienceItem } from '../data/profile';

export interface Props {
  items: ExperienceItem[];
  compact?: boolean;
}

const { items, compact = false } = Astro.props;
---

<div class="dossier-ledger">
  {
    items.map((item) => {
      const isHighlightRole =
        item.statusType === 'Current Responsibility' ||
        item.statusType === 'Unverified — Legacy Website Only (Pending Confirmation)';
      return (
        <article class="dossier-row" id={item.id}>
          <!-- Col 1: Dates, Organization, Location & Verification Status -->
          <div class="dossier-meta">
            <span class="dossier-period">{item.period}</span>
            <h3 class="dossier-org">{item.organization}</h3>
            <p class="dossier-loc">{item.location}</p>
            <div style="margin-top: 0.35rem;">
              <span class:list={['status-tag', { 'status-tag-rubric': isHighlightRole }]}>
                {item.statusType}
              </span>
            </div>
            {item.periodNote && !compact && <p class="dossier-note">{item.periodNote}</p>}
          </div>

          <!-- Col 2: Role, Scannable Highlights & Stack -->
          <div class="dossier-content">
            <div class="dossier-role-line">
              <h4 class="dossier-role">{item.role}</h4>
              <span class="mono-cite">{item.domainTag}</span>
            </div>
            {item.secondaryRole && <p class="dossier-secondary">{item.secondaryRole}</p>}

            <p class="dossier-summary">{item.summary}</p>

            <ul class="dossier-points">
              {(compact ? item.highlights.slice(0, 2) : item.highlights).map((pt) => (
                <li>
                  <strong>{pt.label}:</strong> {pt.detail}
                </li>
              ))}
            </ul>

            <p class="dossier-stack">
              <span class="sidenote-label">Methods &amp; Tools:</span> {item.technologies.join(' · ')}
            </p>
          </div>
        </article>
      );
    })
  }
</div>
