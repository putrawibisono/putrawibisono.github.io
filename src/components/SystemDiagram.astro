---
export interface Props {
  type:
    | 'agritech-pipeline'
    | 'battery-telemetry'
    | 'spectroscopy-bandgap'
    | 'lpcvd-reactor'
    | 'gitlet-dag'
    | 'signal-processing';
}

const { type } = Astro.props;
---

<figure class="archival-figure">
  {
    type === 'agritech-pipeline' && (
      <svg viewBox="0 0 680 220" fill="none" xmlns="http://www.w3.org/2000/svg" class="ink-schematic">
        <line x1="16" y1="28" x2="664" y2="28" class="fig-hairline" />
        <text x="16" y="18" class="fig-caption-top">FIG. 1.1 — SATELLITE &amp; IN-SITU SOIL TELEMETRY ARCHITECTURE (AGROS INDUSTRY)</text>

        <rect x="16" y="48" width="150" height="62" class="fig-box" />
        <text x="28" y="68" class="fig-num">I. REMOTE SENSING</text>
        <text x="28" y="88" class="fig-title">Historical Satellite</text>
        <text x="28" y="102" class="fig-sub">Spectral Field Baseline</text>

        <rect x="16" y="128" width="150" height="62" class="fig-box" />
        <text x="28" y="148" class="fig-num">II. IN-SITU PROBES</text>
        <text x="28" y="168" class="fig-title">Field IoT Stream</text>
        <text x="28" y="182" class="fig-sub">Soil pH · Moisture · NPK</text>

        <path d="M166 79 H214 V112 H252" class="fig-stroke" />
        <path d="M166 159 H214 V126 H252" class="fig-stroke" />

        <rect x="252" y="64" width="184" height="110" class="fig-box-rubric" />
        <text x="268" y="88" class="fig-num-rubric">III. AGRONOMIC ENGINE</text>
        <text x="268" y="110" class="fig-title">Demo Plot Trial &amp;</text>
        <text x="268" y="128" class="fig-title">Yield Model</text>
        <text x="268" y="150" class="fig-sub">Organic Fertilizer Validation</text>

        <path d="M436 119 H488" class="fig-stroke-rubric" />

        <rect x="488" y="54" width="176" height="54" class="fig-box" />
        <text x="502" y="74" class="fig-num">IV-A. INSTITUTIONAL</text>
        <text x="502" y="94" class="fig-title">Gov &amp; Partner Ledgers</text>

        <rect x="488" y="126" width="176" height="54" class="fig-box" />
        <text x="502" y="146" class="fig-num">IV-B. EXTENSION</text>
        <text x="502" y="166" class="fig-title">Farmer Advisory Tools</text>
      </svg>
    )
  }

  {
    type === 'battery-telemetry' && (
      <svg viewBox="0 0 680 220" fill="none" xmlns="http://www.w3.org/2000/svg" class="ink-schematic">
        <line x1="16" y1="28" x2="664" y2="28" class="fig-hairline" />
        <text x="16" y="18" class="fig-caption-top">FIG. 2.1 — 4680 FORMATION SCREENING (FAST) &amp; MULTI-GIGAFACTORY TELEMETRY (RAPID)</text>

        <rect x="16" y="48" width="154" height="62" class="fig-box" />
        <text x="28" y="68" class="fig-num">GFTX · BERLIN · MILMONT</text>
        <text x="28" y="88" class="fig-title">4680C/D Cell Cyclers</text>
        <text x="28" y="102" class="fig-sub">Temp · pH · Current</text>

        <rect x="16" y="128" width="154" height="62" class="fig-box" />
        <text x="28" y="148" class="fig-num">API CALL &amp; SYNC</text>
        <text x="28" y="168" class="fig-title">Recipe Registry</text>
        <text x="28" y="182" class="fig-sub">R&amp;D Formation Trials</text>

        <path d="M170 79 H242" class="fig-stroke" />
        <path d="M170 159 H242" class="fig-stroke" />

        <rect x="242" y="48" width="190" height="62" class="fig-box-rubric" />
        <text x="256" y="68" class="fig-num-rubric">FAST // PYTHON LIBRARY</text>
        <text x="256" y="88" class="fig-title">Formation Screening</text>
        <text x="256" y="102" class="fig-sub">Deterministic Trial Conclusion</text>

        <rect x="242" y="128" width="190" height="62" class="fig-box-rubric" />
        <text x="256" y="148" class="fig-num-rubric">RAPID // LIVE DASHBOARD</text>
        <text x="256" y="168" class="fig-title">Line Control &amp; EoL</text>
        <text x="256" y="182" class="fig-sub">Defect &amp; Vendor Scoring</text>

        <path d="M432 79 H492" class="fig-stroke-rubric" />
        <path d="M432 159 H492" class="fig-stroke-rubric" />

        <rect x="492" y="66" width="172" height="106" class="fig-box" />
        <text x="506" y="90" class="fig-num">GEN 4 &amp; 5 MODELS</text>
        <text x="506" y="112" class="fig-title">Cell Simulation</text>
        <text x="506" y="132" class="fig-sub">Model 3 / Model Y</text>
        <text x="506" y="148" class="fig-sub">Cross-Vendor Analytics</text>
      </svg>
    )
  }

  {
    type === 'spectroscopy-bandgap' && (
      <svg viewBox="0 0 680 220" fill="none" xmlns="http://www.w3.org/2000/svg" class="ink-schematic">
        <line x1="16" y1="28" x2="664" y2="28" class="fig-hairline" />
        <text x="16" y="18" class="fig-caption-top">FIG. 3.1 — OPTICAL ABSORPTION TAUC EXTRACTION: (αhν)^n VS. PHOTON ENERGY (hν)</text>

        <rect x="16" y="44" width="270" height="154" class="fig-box" />
        <line x1="54" y1="172" x2="262" y2="172" class="fig-stroke" />
        <line x1="54" y1="62" x2="54" y2="172" class="fig-stroke" />
        <path d="M60 169 Q124 167 154 144 T242 70" class="fig-stroke-rubric" />
        <line x1="146" y1="172" x2="236" y2="76" class="fig-dashed" />
        <circle cx="146" cy="172" r="3.5" class="fig-dot-rubric" />
        <text x="128" y="190" class="fig-num-rubric">Eg (Band Gap)</text>
        <text x="64" y="78" class="fig-sub">(αhν)^2</text>

        <path d="M286 121 H342" class="fig-stroke" />

        <rect x="342" y="44" width="322" height="154" class="fig-box-rubric" />
        <text x="362" y="72" class="fig-num-rubric">DUAL-SPECTROMETER REDUCTION PROTOCOL</text>
        <text x="362" y="96" class="fig-title">Shimadzu SolidSpec-3700 UV-Vis-NIR</text>
        <text x="362" y="120" class="fig-sub">1. Transmittance &amp; Reflectance Baseline Stitching</text>
        <text x="362" y="140" class="fig-sub">2. Detector Transition &amp; Substrate Correction</text>
        <text x="362" y="160" class="fig-sub">3. Linear-Regime Extrapolation of Band Edge Eg</text>
      </svg>
    )
  }

  {
    type === 'lpcvd-reactor' && (
      <svg viewBox="0 0 680 220" fill="none" xmlns="http://www.w3.org/2000/svg" class="ink-schematic">
        <line x1="16" y1="28" x2="664" y2="28" class="fig-hairline" />
        <text x="16" y="18" class="fig-caption-top">FIG. 4.1 — QUARTZ BOAT LPCVD WAFER REACTOR &amp; 2^k FACTORIAL UNIFORMITY MODEL</text>

        <rect x="16" y="54" width="356" height="132" class="fig-box-rubric" />
        <text x="34" y="78" class="fig-num-rubric">COMSOL MULTIPHYSICS // LAMINAR TRANSPORT ZONE</text>
        <line x1="38" y1="122" x2="348" y2="122" class="fig-dashed" />
        <line x1="110" y1="92" x2="110" y2="152" class="fig-wafer" />
        <line x1="148" y1="92" x2="148" y2="152" class="fig-wafer" />
        <line x1="186" y1="92" x2="186" y2="152" class="fig-wafer" />
        <line x1="224" y1="92" x2="224" y2="152" class="fig-wafer" />
        <line x1="262" y1="92" x2="262" y2="152" class="fig-wafer" />
        <line x1="300" y1="92" x2="300" y2="152" class="fig-wafer" />
        <text x="34" y="172" class="fig-sub">Coupled Fluid Dynamics, Heat Transfer &amp; Surface Deposition</text>

        <path d="M372 120 H422" class="fig-stroke" />

        <rect x="422" y="54" width="242" height="132" class="fig-box" />
        <text x="440" y="78" class="fig-num">2^k DESIGN OF EXPERIMENTS</text>
        <text x="440" y="102" class="fig-title">~100% Wafer Uniformity</text>
        <text x="440" y="126" class="fig-sub">· 2D &amp; 3D MATLAB Surface Maps</text>
        <text x="440" y="146" class="fig-sub">· Pressure, Flow &amp; Temp Screening</text>
      </svg>
    )
  }

  {
    type === 'gitlet-dag' && (
      <svg viewBox="0 0 680 220" fill="none" xmlns="http://www.w3.org/2000/svg" class="ink-schematic">
        <line x1="16" y1="28" x2="664" y2="28" class="fig-hairline" />
        <text x="16" y="18" class="fig-caption-top">FIG. 5.1 — CONTENT-ADDRESSABLE COMMIT DAG &amp; THREE-WAY MERGE RESOLUTION (JAVA)</text>

        <rect x="16" y="44" width="648" height="154" class="fig-box" />
        <line x1="88" y1="108" x2="482" y2="108" class="fig-stroke" />
        <path d="M192 108 C222 108 228 156 264 156 H402 C438 156 446 108 482 108" class="fig-stroke-rubric" />

        <circle cx="88" cy="108" r="12" class="fig-node" />
        <circle cx="192" cy="108" r="12" class="fig-node" />
        <circle cx="304" cy="108" r="12" class="fig-node" />
        <circle cx="304" cy="156" r="12" class="fig-node" />
        <circle cx="402" cy="156" r="12" class="fig-node" />
        <circle cx="482" cy="108" r="14" class="fig-dot-rubric" />

        <text x="74" y="84" class="fig-num">init</text>
        <text x="168" y="84" class="fig-num">split (LCA)</text>
        <text x="462" y="84" class="fig-num-rubric">merge</text>
        <text x="512" y="113" class="fig-title">HEAD (O(n) Branching)</text>
      </svg>
    )
  }

  {
    type === 'signal-processing' && (
      <svg viewBox="0 0 680 220" fill="none" xmlns="http://www.w3.org/2000/svg" class="ink-schematic">
        <line x1="16" y1="28" x2="664" y2="28" class="fig-hairline" />
        <text x="16" y="18" class="fig-caption-top">FIG. 6.1 — G-CODE MOTORIZED ACOUSTIC FIELD SCANNER &amp; PWM DAC CONDITIONING</text>

        <rect x="16" y="52" width="190" height="134" class="fig-box" />
        <text x="32" y="78" class="fig-num">I. MOTION STAGE</text>
        <text x="32" y="102" class="fig-title">Arduino + G-Code</text>
        <text x="32" y="124" class="fig-sub">Automated Spatial</text>
        <text x="32" y="142" class="fig-sub">Sensor Positioning</text>

        <path d="M206 119 H248" class="fig-stroke" />

        <rect x="248" y="52" width="190" height="134" class="fig-box-rubric" />
        <text x="264" y="78" class="fig-num-rubric">II. ANALOG FILTER</text>
        <text x="264" y="102" class="fig-title">PWM + Low-Pass</text>
        <path d="M266 150 Q286 122 306 150 T346 150 T386 150" class="fig-stroke-rubric" />

        <path d="M438 119 H478" class="fig-stroke" />

        <rect x="478" y="52" width="186" height="134" class="fig-box" />
        <text x="494" y="78" class="fig-num">III. RECONSTRUCTION</text>
        <text x="494" y="102" class="fig-title">MATLAB SNR &amp; Video</text>
        <text x="494" y="124" class="fig-sub">Time-Domain Averaging</text>
        <text x="494" y="142" class="fig-sub">&amp; Resolution Analysis</text>
      </svg>
    )
  }
</figure>

<style>
  .archival-figure {
    width: 100%;
    background: var(--paper-tint);
    border-top: 1px solid var(--rule-strong);
    border-bottom: 1px solid var(--rule);
    padding: 0.9rem 0.75rem;
  }

  .ink-schematic {
    width: 100%;
    height: auto;
  }

  .fig-hairline {
    stroke: var(--rule);
    stroke-width: 1;
  }

  .fig-caption-top {
    fill: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.06em;
  }

  .fig-box {
    fill: var(--paper);
    stroke: var(--ink);
    stroke-width: 1;
  }

  .fig-box-rubric {
    fill: var(--paper);
    stroke: var(--rubric);
    stroke-width: 1.4;
  }

  .fig-num {
    fill: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.05em;
  }

  .fig-num-rubric {
    fill: var(--rubric);
    font-family: var(--font-mono);
    font-size: 9.5px;
    font-weight: 500;
    letter-spacing: 0.05em;
  }

  .fig-title {
    fill: var(--ink);
    font-family: var(--font-serif);
    font-size: 14.5px;
  }

  .fig-sub {
    fill: var(--ink-secondary);
    font-family: var(--font-sans);
    font-size: 10.5px;
  }

  .fig-stroke {
    stroke: var(--ink);
    stroke-width: 1.2;
    fill: none;
  }

  .fig-stroke-rubric {
    stroke: var(--rubric);
    stroke-width: 1.6;
    fill: none;
  }

  .fig-dashed {
    stroke: var(--ink-muted);
    stroke-width: 1.1;
    stroke-dasharray: 4 3;
  }

  .fig-wafer {
    stroke: var(--rubric);
    stroke-width: 2.2;
  }

  .fig-node {
    fill: var(--paper);
    stroke: var(--ink);
    stroke-width: 1.4;
  }

  .fig-dot-rubric {
    fill: var(--rubric);
  }
</style>
